<%- include('partials/head', { pageTitle: 'Service Contracts - ERPPOS' }) %>

<%- include('partials/sidebar') %>

<div class="pl-64 min-h-screen flex flex-col bg-slate-50">
  <%- include('partials/header') %>

  <main class="relative pt-28 px-6 pb-12 flex-1">
    <div class="w-full space-y-4">

      <!-- Header Row matching screenshot media_1790274409296.png -->
      <div class="bg-white p-4 rounded-xl border border-slate-200/80 shadow-xs flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-sky-500 text-white flex items-center justify-center shadow-xs">
            <span class="material-symbols-outlined text-[22px]">assignment</span>
          </div>
          <div>
            <h1 class="text-base font-bold text-slate-800">Service Contracts</h1>
            <p class="text-xs text-slate-500 font-medium"><%= (contracts || []).length %> contracts</p>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <button onclick="window.location.reload()" class="w-9 h-9 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 flex items-center justify-center text-slate-600 transition-colors shadow-xs" title="Refresh">
            <span class="material-symbols-outlined text-[18px]">sync</span>
          </button>
          <button onclick="openNewContractModal()" class="inline-flex items-center gap-1.5 px-4 py-2 bg-orange-500 hover:bg-orange-600 text-white rounded-lg text-xs font-semibold shadow-xs transition-all active:scale-95">
            <span class="material-symbols-outlined text-[16px]">add</span>
            New Contract
          </button>
        </div>
      </div>

      <!-- Contracts Table matching screenshot -->
      <div class="bg-white rounded-xl border border-slate-200/80 shadow-xs overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs" id="contractsTable">
            <thead class="bg-slate-50/80 text-[11px] font-bold text-slate-500 uppercase tracking-wider border-b border-slate-200/80">
              <tr>
                <th class="py-3 px-4">Contract No</th>
                <th class="py-3 px-4">Date</th>
                <th class="py-3 px-4">Customer</th>
                <th class="py-3 px-4">Type</th>
                <th class="py-3 px-4">Start</th>
                <th class="py-3 px-4">End</th>
                <th class="py-3 px-4">Billing</th>
                <th class="py-3 px-4">Amount</th>
                <th class="py-3 px-4">Response Hrs</th>
                <th class="py-3 px-4">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-slate-700">
              <% (contracts || []).forEach(c => { 
                  let typeClass = 'bg-emerald-100 text-emerald-800';
                  if (c.type === 'AMC') typeClass = 'bg-purple-100 text-purple-800';
                  if (c.type === 'CMC') typeClass = 'bg-blue-100 text-blue-800';
              %>
                <tr class="hover:bg-slate-50/80 transition-colors">
                  <td class="py-3.5 px-4 font-mono font-semibold text-sky-600 hover:underline cursor-pointer" onclick="viewContract('<%= c.contractNo %>')">
                    <%= c.contractNo %>
                  </td>
                  <td class="py-3.5 px-4 text-slate-600"><%= c.date %></td>
                  <td class="py-3.5 px-4 font-medium text-slate-800"><%= c.customer %></td>
                  <td class="py-3.5 px-4">
                    <span class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-semibold <%= typeClass %>">
                      <%= c.type %>
                    </span>
                  </td>
                  <td class="py-3.5 px-4 font-mono text-slate-600"><%= c.start %></td>
                  <td class="py-3.5 px-4 font-mono text-slate-600"><%= c.end %></td>
                  <td class="py-3.5 px-4 text-slate-700"><%= c.billing %></td>
                  <td class="py-3.5 px-4 font-mono font-semibold text-slate-800"><%= c.amount %></td>
                  <td class="py-3.5 px-4 text-slate-700 font-mono"><%= c.responseHrs %></td>
                  <td class="py-3.5 px-4 font-medium text-slate-800"><%= c.status %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </main>
</div>

<!-- Modal: New Contract -->
<div id="newContractModal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-slate-100">
    <div class="flex items-center justify-between pb-3 border-b border-slate-200">
      <h3 class="text-base font-bold text-slate-800">Add New Service Contract</h3>
      <button onclick="closeNewContractModal()" class="w-8 h-8 rounded-lg hover:bg-slate-100 text-slate-400 hover:text-slate-600 flex items-center justify-center">
        <span class="material-symbols-outlined text-[18px]">close</span>
      </button>
    </div>

    <form id="newContractForm" onsubmit="submitNewContract(event)" class="py-4 space-y-3 text-xs">
      <div>
        <label class="block font-semibold text-slate-700 mb-1">Customer Name *</label>
        <input type="text" id="contractCustomer" required class="w-full px-3 py-2 border border-slate-200 rounded-lg outline-none focus:border-sky-500 text-xs" placeholder="e.g. Sathya Agencies" />
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Contract Type</label>
          <select id="contractType" class="w-full px-3 py-2 border border-slate-200 rounded-lg outline-none focus:border-sky-500 text-xs">
            <option value="Warranty">Warranty</option>
            <option value="AMC">AMC</option>
            <option value="CMC">CMC</option>
          </select>
        </div>
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Billing Type</label>
          <select id="contractBilling" class="w-full px-3 py-2 border border-slate-200 rounded-lg outline-none focus:border-sky-500 text-xs">
            <option value="Free">Free</option>
            <option value="Annual">Annual</option>
            <option value="Monthly">Monthly</option>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Start Date</label>
          <input type="date" id="contractStart" class="w-full px-3 py-2 border border-slate-200 rounded-lg outline-none focus:border-sky-500 text-xs" />
        </div>
        <div>
          <label class="block font-semibold text-slate-700 mb-1">End Date</label>
          <input type="date" id="contractEnd" class="w-full px-3 py-2 border border-slate-200 rounded-lg outline-none focus:border-sky-500 text-xs" />
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Amount (₹)</label>
          <input type="text" id="contractAmount" value="0.00" class="w-full px-3 py-2 border border-slate-200 rounded-lg outline-none focus:border-sky-500 text-xs font-mono" />
        </div>
        <div>
          <label class="block font-semibold text-slate-700 mb-1">SLA Response (Hours)</label>
          <input type="number" id="contractResponseHrs" value="24" class="w-full px-3 py-2 border border-slate-200 rounded-lg outline-none focus:border-sky-500 text-xs font-mono" />
        </div>
      </div>

      <div class="pt-3 border-t border-slate-200 flex justify-end gap-2">
        <button type="button" onclick="closeNewContractModal()" class="px-4 py-2 border border-slate-300 hover:bg-slate-50 rounded-lg text-xs font-medium text-slate-700">Cancel</button>
        <button type="submit" class="px-4 py-2 bg-orange-500 hover:bg-orange-600 text-white rounded-lg text-xs font-semibold shadow-xs">Save Contract</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openNewContractModal() {
    document.getElementById('newContractModal').classList.remove('hidden');
    const today = new Date().toISOString().split('T')[0];
    document.getElementById('contractStart').value = today;
  }

  function closeNewContractModal() {
    document.getElementById('newContractModal').classList.add('hidden');
  }

  async function submitNewContract(e) {
    e.preventDefault();
    const payload = {
      customer: document.getElementById('contractCustomer').value.trim(),
      type: document.getElementById('contractType').value,
      billing: document.getElementById('contractBilling').value,
      start: document.getElementById('contractStart').value,
      end: document.getElementById('contractEnd').value,
      amount: document.getElementById('contractAmount').value.trim(),
      responseHrs: parseInt(document.getElementById('contractResponseHrs').value) || 24
    };

    try {
      const res = await fetch('/api/service-contracts', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      } else {
        alert(data.error || 'Failed to save contract');
      }
    } catch (err) {
      console.error(err);
      alert('Network error saving contract');
    }
  }

  function viewContract(id) {
    alert(`Service Contract ${id} active. Standard warranty and replacement coverage applied.`);
  }
</script>
