<%- include('partials/head', { pageTitle: 'Service Calls - ERPPOS' }) %>

<%- include('partials/sidebar') %>

<div class="pl-64 min-h-screen flex flex-col bg-slate-50">
  <%- include('partials/header') %>

  <main class="relative pt-28 px-6 pb-12 flex-1">
    <div class="w-full space-y-4">

      <!-- Top Title & Action Header matching screenshot media_1790274409453.png -->
      <div class="bg-white p-4 rounded-xl border border-slate-200/80 shadow-xs flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-sky-500 text-white flex items-center justify-center shadow-xs">
            <span class="material-symbols-outlined text-[22px]">build</span>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <h1 class="text-base font-bold text-slate-800">Service Calls</h1>
              <span class="text-xs text-slate-500 font-medium">• <%= (serviceCalls || []).length %> of <%= (serviceCalls || []).length %> calls</span>
            </div>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <button onclick="window.location.reload()" class="w-9 h-9 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 flex items-center justify-center text-slate-600 transition-colors shadow-xs" title="Refresh">
            <span class="material-symbols-outlined text-[18px]">sync</span>
          </button>
          <button onclick="openNewCallModal()" class="inline-flex items-center gap-1.5 px-4 py-2 bg-orange-500 hover:bg-orange-600 text-white rounded-lg text-xs font-semibold shadow-xs transition-all active:scale-95">
            <span class="material-symbols-outlined text-[16px]">add</span>
            New Call
          </button>
        </div>
      </div>

      <!-- 2-Tier Filter Box matching screenshot media_1790274409453.png -->
      <div class="bg-white p-4 rounded-xl border border-slate-200/80 shadow-xs space-y-3">
        <!-- Row 1 Filters -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
          <div class="flex items-center justify-between bg-white border border-slate-200 rounded-lg px-2.5 py-1.5 text-xs">
            <input type="text" placeholder="dd - mm - yyyy" class="bg-transparent border-none outline-none w-24 text-slate-700 font-mono" />
            <span class="material-symbols-outlined text-slate-400 text-[16px]">calendar_today</span>
          </div>

          <div class="flex items-center justify-between bg-white border-2 border-sky-500 rounded-lg px-2.5 py-1.5 text-xs shadow-2xs">
            <input type="text" value="dd - mm - yyyy" class="bg-transparent border-none outline-none w-24 text-slate-700 font-mono" />
            <span class="material-symbols-outlined text-slate-400 text-[16px]">calendar_today</span>
          </div>

          <div>
            <input id="filterCust" onkeyup="filterCallsTable()" type="text" placeholder="Customer" class="w-full bg-white border border-slate-200 rounded-lg px-3 py-1.5 text-xs text-slate-700 outline-none focus:border-sky-500" />
          </div>

          <div>
            <input id="filterMobile" onkeyup="filterCallsTable()" type="text" placeholder="Mobile" class="w-full bg-white border border-slate-200 rounded-lg px-3 py-1.5 text-xs text-slate-700 outline-none focus:border-sky-500 font-mono" />
          </div>

          <div>
            <input id="filterItem" onkeyup="filterCallsTable()" type="text" placeholder="Item Code" class="w-full bg-white border border-slate-200 rounded-lg px-3 py-1.5 text-xs text-slate-700 outline-none focus:border-sky-500 font-mono" />
          </div>
        </div>

        <!-- Row 2 Filters -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
          <div>
            <input id="filterSerial" onkeyup="filterCallsTable()" type="text" placeholder="Serial No" class="w-full bg-white border border-slate-200 rounded-lg px-3 py-1.5 text-xs text-slate-700 outline-none focus:border-sky-500 font-mono" />
          </div>

          <div>
            <select id="filterStatus" onchange="filterCallsTable()" class="w-full bg-white border border-slate-200 rounded-lg px-3 py-1.5 text-xs text-slate-700 outline-none focus:border-sky-500">
              <option value="All">All Status</option>
              <option value="Open">Open</option>
              <option value="Assigned">Assigned</option>
              <option value="In Progress">In Progress</option>
              <option value="Pending Spare">Pending Spare</option>
              <option value="Resolved">Resolved</option>
              <option value="Closed">Closed</option>
            </select>
          </div>

          <div>
            <select id="filterPriority" onchange="filterCallsTable()" class="w-full bg-white border border-slate-200 rounded-lg px-3 py-1.5 text-xs text-slate-700 outline-none focus:border-sky-500">
              <option value="All">All Priority</option>
              <option value="Low">Low</option>
              <option value="Medium">Medium</option>
              <option value="High">High</option>
              <option value="Critical">Critical</option>
            </select>
          </div>

          <div>
            <select id="filterTech" onchange="filterCallsTable()" class="w-full bg-white border border-slate-200 rounded-lg px-3 py-1.5 text-xs text-slate-700 outline-none focus:border-sky-500">
              <option value="All">All Technicians</option>
              <option value="Ramesh">Ramesh</option>
              <option value="Naresh">Naresh</option>
              <option value="Suresh">Suresh</option>
              <option value="Mahesh">Mahesh</option>
            </select>
          </div>

          <div>
            <select class="w-full bg-white border border-slate-200 rounded-lg px-3 py-1.5 text-xs text-slate-700 outline-none focus:border-sky-500">
              <option>All Contracts</option>
              <option>Warranty</option>
              <option>AMC</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Service Calls Table matching screenshot media_1790274409453.png -->
      <div class="bg-white rounded-xl border border-slate-200/80 shadow-xs overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs" id="serviceCallsTable">
            <thead class="bg-slate-50/80 text-[11px] font-bold text-slate-500 uppercase tracking-wider border-b border-slate-200/80">
              <tr>
                <th class="py-3 px-3.5">Call No</th>
                <th class="py-3 px-3.5">Date</th>
                <th class="py-3 px-3.5">Customer</th>
                <th class="py-3 px-3.5">Mobile</th>
                <th class="py-3 px-3.5">Item</th>
                <th class="py-3 px-3.5">Serial</th>
                <th class="py-3 px-3.5">Problem</th>
                <th class="py-3 px-3.5 text-center">Priority</th>
                <th class="py-3 px-3.5">Technician</th>
                <th class="py-3 px-3.5 text-center">Status</th>
                <th class="py-3 px-3.5">Due</th>
                <th class="py-3 px-3.5 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-slate-700">
              <% (serviceCalls || []).forEach(c => { 
                  let priClass = 'bg-slate-100 text-slate-700';
                  if (c.priority === 'Critical') priClass = 'bg-red-100 text-red-700';
                  if (c.priority === 'High') priClass = 'bg-amber-100 text-amber-800';
                  if (c.priority === 'Medium') priClass = 'bg-sky-100 text-sky-700';
                  if (c.priority === 'Low') priClass = 'bg-slate-100 text-slate-600';

                  let statClass = 'bg-slate-100 text-slate-600';
                  if (c.status === 'Assigned') statClass = 'bg-sky-100 text-sky-700';
                  if (c.status === 'In Progress') statClass = 'bg-amber-100 text-amber-800';
                  if (c.status === 'Pending Spare') statClass = 'bg-purple-100 text-purple-700';
                  if (c.status === 'Resolved') statClass = 'bg-emerald-100 text-emerald-800';
                  if (c.status === 'Closed') statClass = 'bg-slate-100 text-slate-500';
              %>
                <tr class="hover:bg-slate-50/80 transition-colors">
                  <td class="py-3.5 px-3.5 font-mono font-semibold text-sky-600 hover:underline cursor-pointer" onclick="viewCall('<%= c.id || c.callNo %>')">
                    <%= c.id || c.callNo %>
                  </td>
                  <td class="py-3.5 px-3.5 text-slate-600 whitespace-nowrap"><%= c.date %></td>
                  <td class="py-3.5 px-3.5 font-medium text-slate-800"><%= c.customer %></td>
                  <td class="py-3.5 px-3.5 font-mono text-slate-600"><%= c.mobile || c.contact || '-' %></td>
                  <td class="py-3.5 px-3.5 font-medium text-slate-800"><%= c.item || c.device %></td>
                  <td class="py-3.5 px-3.5 font-mono text-slate-500 text-[11px]"><%= c.serial || '-' %></td>
                  <td class="py-3.5 px-3.5 text-slate-700"><%= c.problem || c.issue %></td>
                  <td class="py-3.5 px-3.5 text-center">
                    <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-semibold <%= priClass %>">
                      <%= c.priority %>
                    </span>
                  </td>
                  <td class="py-3.5 px-3.5 font-medium text-slate-700"><%= c.technician || c.technicianName || '—' %></td>
                  <td class="py-3.5 px-3.5 text-center">
                    <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-semibold <%= statClass %>">
                      <%= c.status %>
                    </span>
                  </td>
                  <td class="py-3.5 px-3.5 font-mono text-slate-500 text-[11px]"><%= c.due || '-' %></td>
                  <td class="py-3.5 px-3.5 text-right">
                    <button class="p-1 hover:bg-slate-100 rounded text-slate-400 hover:text-slate-600" title="Options">
                      <span class="material-symbols-outlined text-[18px]">more_horiz</span>
                    </button>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </main>
</div>

<!-- Modal: New Call -->
<div id="newCallModal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-slate-100">
    <div class="flex items-center justify-between pb-3 border-b border-slate-200">
      <h3 class="text-base font-bold text-slate-800">Log New Service Call</h3>
      <button onclick="closeNewCallModal()" class="w-8 h-8 rounded-lg hover:bg-slate-100 text-slate-400 hover:text-slate-600 flex items-center justify-center">
        <span class="material-symbols-outlined text-[18px]">close</span>
      </button>
    </div>

    <form id="newCallForm" onsubmit="submitNewCall(event)" class="py-4 space-y-3 text-xs">
      <div>
        <label class="block font-semibold text-slate-700 mb-1">Customer Name *</label>
        <input type="text" id="callCustName" required class="w-full px-3 py-2 border border-slate-200 rounded-lg outline-none focus:border-sky-500 text-xs" placeholder="e.g. Sathya Agencies" />
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Mobile Phone</label>
          <input type="tel" id="callMobile" class="w-full px-3 py-2 border border-slate-200 rounded-lg outline-none focus:border-sky-500 text-xs font-mono" placeholder="98XXXXXXXX" />
        </div>
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Priority</label>
          <select id="callPriority" class="w-full px-3 py-2 border border-slate-200 rounded-lg outline-none focus:border-sky-500 text-xs">
            <option value="Medium">Medium</option>
            <option value="High">High</option>
            <option value="Critical">Critical</option>
            <option value="Low">Low</option>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Equipment / Item</label>
          <input type="text" id="callItem" class="w-full px-3 py-2 border border-slate-200 rounded-lg outline-none focus:border-sky-500 text-xs" placeholder="e.g. Samsung 55 Inch TV" />
        </div>
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Serial Number</label>
          <input type="text" id="callSerial" class="w-full px-3 py-2 border border-slate-200 rounded-lg outline-none focus:border-sky-500 text-xs font-mono" placeholder="SN-TV-10001" />
        </div>
      </div>

      <div>
        <label class="block font-semibold text-slate-700 mb-1">Reported Issue / Problem</label>
        <textarea id="callProblem" rows="2" class="w-full px-3 py-2 border border-slate-200 rounded-lg outline-none focus:border-sky-500 text-xs" placeholder="Describe the fault or symptom"></textarea>
      </div>

      <div class="pt-3 border-t border-slate-200 flex justify-end gap-2">
        <button type="button" onclick="closeNewCallModal()" class="px-4 py-2 border border-slate-300 hover:bg-slate-50 rounded-lg text-xs font-medium text-slate-700">Cancel</button>
        <button type="submit" class="px-4 py-2 bg-orange-500 hover:bg-orange-600 text-white rounded-lg text-xs font-semibold shadow-xs">Register Call</button>
      </div>
    </form>
  </div>
</div>

<script>
  function filterCallsTable() {
    const cust = document.getElementById('filterCust').value.toLowerCase();
    const mob = document.getElementById('filterMobile').value.toLowerCase();
    const item = document.getElementById('filterItem').value.toLowerCase();
    const serial = document.getElementById('filterSerial').value.toLowerCase();
    const status = document.getElementById('filterStatus').value.toLowerCase();
    const priority = document.getElementById('filterPriority').value.toLowerCase();
    const tech = document.getElementById('filterTech').value.toLowerCase();

    const rows = document.querySelectorAll('#serviceCallsTable tbody tr');
    rows.forEach(r => {
      const text = r.innerText.toLowerCase();
      const matchCust = !cust || text.includes(cust);
      const matchMob = !mob || text.includes(mob);
      const matchItem = !item || text.includes(item);
      const matchSerial = !serial || text.includes(serial);
      const matchStatus = status === 'all' || text.includes(status);
      const matchPri = priority === 'all' || text.includes(priority);
      const matchTech = tech === 'all' || text.includes(tech);

      r.style.display = (matchCust && matchMob && matchItem && matchSerial && matchStatus && matchPri && matchTech) ? '' : 'none';
    });
  }

  function openNewCallModal() {
    document.getElementById('newCallModal').classList.remove('hidden');
  }

  function closeNewCallModal() {
    document.getElementById('newCallModal').classList.add('hidden');
  }

  async function submitNewCall(e) {
    e.preventDefault();
    const payload = {
      customer: document.getElementById('callCustName').value.trim(),
      contact: document.getElementById('callMobile').value.trim(),
      mobile: document.getElementById('callMobile').value.trim(),
      priority: document.getElementById('callPriority').value,
      device: document.getElementById('callItem').value.trim(),
      item: document.getElementById('callItem').value.trim(),
      serial: document.getElementById('callSerial').value.trim(),
      issue: document.getElementById('callProblem').value.trim(),
      problem: document.getElementById('callProblem').value.trim()
    };

    try {
      const res = await fetch('/api/service-calls', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      }
    } catch (err) {
      console.error(err);
    }
  }

  function viewCall(id) {
    alert(`Service Call #${id} view opened.`);
  }
</script>
