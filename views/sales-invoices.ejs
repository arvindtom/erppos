<%- include('partials/head', { pageTitle: 'Sales Invoices - ERPPOS' }) %>

<%- include('partials/sidebar') %>

<div class="pl-64 min-h-screen flex flex-col bg-slate-50">
  <%- include('partials/header') %>

  <main class="relative pt-28 px-6 pb-12 flex-1">
    <div class="w-full space-y-3">

      <!-- Header Row matching screenshot -->
      <div class="flex items-center justify-between">
        <h1 class="text-lg font-bold text-slate-800">Sales Invoices</h1>

        <div class="flex items-center gap-2">
          <button onclick="exportInvoices()" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-slate-200 hover:bg-slate-50 rounded-lg text-xs font-semibold text-slate-700 shadow-xs transition-colors">
            <span class="material-symbols-outlined text-[16px] text-slate-500">description</span>
            Export
          </button>
          <button onclick="window.location.reload()" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-slate-200 hover:bg-slate-50 rounded-lg text-xs font-semibold text-slate-700 shadow-xs transition-colors">
            <span class="material-symbols-outlined text-[16px] text-slate-500">sync</span>
            Refresh
          </button>
          <button onclick="openNewInvoiceModal()" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-[#0284c7] hover:bg-sky-700 text-white rounded-lg text-xs font-semibold shadow-xs transition-all">
            <span class="material-symbols-outlined text-[16px]">add</span>
            New Invoice
          </button>
        </div>
      </div>

      <!-- Filter Controls Bar matching screenshot -->
      <div class="bg-white p-3 rounded-xl border border-slate-200 shadow-xs flex flex-wrap items-center gap-3">
        <!-- Search -->
        <div class="relative flex-1 min-w-[260px]">
          <div class="flex items-center w-full bg-white rounded-lg px-3 py-1.5 border border-slate-200 focus-within:border-sky-500 transition-all">
            <span class="material-symbols-outlined text-slate-400 text-[18px] mr-2">search</span>
            <input 
              id="invoiceSearchInput" 
              class="bg-transparent border-none outline-none w-full text-xs text-slate-800 placeholder:text-slate-400" 
              placeholder="Search by Invoice No, Customer, Mobile..." 
              type="text"
              onkeyup="filterInvoiceTable()"
            />
          </div>
        </div>

        <!-- Date Range -->
        <div class="flex items-center gap-2 text-xs text-slate-500">
          <div class="flex items-center gap-1.5 bg-white border border-slate-200 rounded-lg px-2.5 py-1.5">
            <input type="text" placeholder="dd - mm - yyyy" class="bg-transparent border-none outline-none text-xs w-24 text-slate-700 font-mono" />
            <span class="material-symbols-outlined text-slate-400 text-[16px]">calendar_today</span>
          </div>
          <span>to</span>
          <div class="flex items-center gap-1.5 bg-white border border-slate-200 rounded-lg px-2.5 py-1.5">
            <input type="text" placeholder="dd - mm - yyyy" class="bg-transparent border-none outline-none text-xs w-24 text-slate-700 font-mono" />
            <span class="material-symbols-outlined text-slate-400 text-[16px]">calendar_today</span>
          </div>
        </div>

        <!-- Store Selector -->
        <div class="min-w-[140px]">
          <select id="invoiceStoreFilter" onchange="filterInvoiceTable()" class="w-full bg-white border border-slate-200 rounded-lg px-3 py-1.5 text-xs text-slate-700 outline-none focus:border-sky-500">
            <option value="ARC1">ARC1 - ARC1</option>
            <option value="ARC2">ARC2 - ARC2</option>
            <option value="All">All Stores</option>
          </select>
        </div>

        <!-- Status Selector -->
        <div class="min-w-[130px]">
          <select id="invoiceStatusFilter" onchange="filterInvoiceTable()" class="w-full bg-white border border-slate-200 rounded-lg px-3 py-1.5 text-xs text-slate-700 outline-none focus:border-sky-500">
            <option value="All">All Status</option>
            <option value="OPEN">OPEN</option>
            <option value="CLOSED">CLOSED</option>
          </select>
        </div>
      </div>

      <!-- Invoices Table matching screenshot -->
      <div class="bg-white rounded-xl border border-slate-200 shadow-xs overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs" id="invoicesTable">
            <thead class="bg-slate-50 text-[11px] font-bold text-slate-500 uppercase tracking-wider border-b border-slate-200">
              <tr>
                <th class="py-3 px-3 w-8">
                  <input type="checkbox" class="rounded border-slate-300 text-sky-600 focus:ring-sky-500" />
                </th>
                <th class="py-3 px-3">INVOICE NO.</th>
                <th class="py-3 px-3">DATE</th>
                <th class="py-3 px-3">CUSTOMER CODE</th>
                <th class="py-3 px-3">NAME</th>
                <th class="py-3 px-3">MOBILE</th>
                <th class="py-3 px-3">STORE</th>
                <th class="py-3 px-3">SALES PERSON</th>
                <th class="py-3 px-3">NOTES</th>
                <th class="py-3 px-3 text-right">INVOICE VALUE</th>
                <th class="py-3 px-3 text-center">INVOICE STATUS</th>
                <th class="py-3 px-3 text-center">APPROVED</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-slate-700">
              <% salesInvoices.forEach(inv => { %>
                <tr class="hover:bg-slate-50/80 transition-colors">
                  <td class="py-3 px-3">
                    <input type="checkbox" class="rounded border-slate-300 text-sky-600 focus:ring-sky-500" />
                  </td>
                  <td class="py-3 px-3 font-mono font-semibold text-sky-600 hover:underline cursor-pointer" onclick="viewInvoiceDetails('<%= inv.invoiceNo %>')">
                    <%= inv.invoiceNo %>
                  </td>
                  <td class="py-3 px-3 text-slate-600 whitespace-nowrap"><%= inv.date %></td>
                  <td class="py-3 px-3 font-mono text-slate-600"><%= inv.customerCode %></td>
                  <td class="py-3 px-3 font-medium text-slate-800"><%= inv.name %></td>
                  <td class="py-3 px-3 font-mono text-slate-600"><%= inv.mobile %></td>
                  <td class="py-3 px-3 font-semibold text-slate-700"><%= inv.store %></td>
                  <td class="py-3 px-3 text-slate-600"><%= inv.salesPerson %></td>
                  <td class="py-3 px-3 text-slate-500 truncate max-w-[140px]" title="<%= inv.notes %>"><%= inv.notes %></td>
                  <td class="py-3 px-3 text-right font-mono font-semibold text-slate-900 whitespace-nowrap">
                    ₹<%= Number(inv.invoiceValue).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %>
                  </td>
                  <td class="py-3 px-3 text-center">
                    <span class="inline-block px-2.5 py-0.5 rounded text-[11px] font-bold bg-sky-100 text-sky-700 border border-sky-200">
                      <%= inv.invoiceStatus %>
                    </span>
                  </td>
                  <td class="py-3 px-3 text-center text-slate-400 font-mono">
                    <%= inv.approved || '-' %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <!-- Table Footer / Pagination matching screenshot -->
        <div class="px-4 py-3 bg-slate-50 border-t border-slate-200 flex flex-wrap items-center justify-between gap-3 text-xs text-slate-600">
          <div class="flex items-center gap-4">
            <span>Showing 1 to <%= salesInvoices.length %> of <%= Math.max(103, salesInvoices.length) %> entries</span>
            <div class="flex items-center gap-1.5">
              <span>Rows:</span>
              <select class="bg-white border border-slate-200 rounded px-2 py-1 text-xs outline-none">
                <option>10</option>
                <option>25</option>
                <option>50</option>
              </select>
            </div>
          </div>

          <div class="flex items-center gap-1">
            <button class="w-7 h-7 flex items-center justify-center rounded border border-slate-200 hover:bg-white text-slate-500">
              <span class="material-symbols-outlined text-[16px]">chevron_left</span>
            </button>
            <button class="w-7 h-7 flex items-center justify-center rounded bg-sky-600 text-white font-bold text-xs">1</button>
            <button class="w-7 h-7 flex items-center justify-center rounded border border-slate-200 hover:bg-white text-slate-700 text-xs">2</button>
            <button class="w-7 h-7 flex items-center justify-center rounded border border-slate-200 hover:bg-white text-slate-700 text-xs">3</button>
            <button class="w-7 h-7 flex items-center justify-center rounded border border-slate-200 hover:bg-white text-slate-500">
              <span class="material-symbols-outlined text-[16px]">chevron_right</span>
            </button>
          </div>
        </div>
      </div>

    </div>
  </main>
</div>

<!-- New Invoice Modal -->
<div id="newInvoiceModal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-slate-100">
    <div class="flex items-center justify-between pb-3 border-b border-slate-200">
      <h3 class="text-base font-bold text-slate-800">Create New Sales Invoice</h3>
      <button onclick="closeNewInvoiceModal()" class="w-8 h-8 rounded-lg hover:bg-slate-100 text-slate-400 hover:text-slate-600 flex items-center justify-center">
        <span class="material-symbols-outlined text-[18px]">close</span>
      </button>
    </div>

    <form id="newInvoiceForm" onsubmit="submitNewInvoice(event)" class="py-4 space-y-3 text-xs">
      <div>
        <label class="block font-semibold text-slate-700 mb-1">Customer Name *</label>
        <input type="text" id="invCustName" required class="w-full px-3 py-2 border border-slate-200 rounded-lg outline-none focus:border-sky-500 text-xs" placeholder="e.g. Ramesh Traders" />
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Mobile No</label>
          <input type="tel" id="invMobile" class="w-full px-3 py-2 border border-slate-200 rounded-lg outline-none focus:border-sky-500 text-xs font-mono" placeholder="98XXXXXXXX" />
        </div>
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Store</label>
          <select id="invStore" class="w-full px-3 py-2 border border-slate-200 rounded-lg outline-none focus:border-sky-500 text-xs">
            <option value="ARC1">ARC1</option>
            <option value="ARC2">ARC2</option>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Invoice Value (₹) *</label>
          <input type="number" id="invAmount" required step="0.01" class="w-full px-3 py-2 border border-slate-200 rounded-lg outline-none focus:border-sky-500 text-xs font-mono" placeholder="12500.00" />
        </div>
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Sales Person</label>
          <input type="text" id="invSalesPerson" value="Admin" class="w-full px-3 py-2 border border-slate-200 rounded-lg outline-none focus:border-sky-500 text-xs" />
        </div>
      </div>

      <div>
        <label class="block font-semibold text-slate-700 mb-1">Notes / Narration</label>
        <input type="text" id="invNotes" class="w-full px-3 py-2 border border-slate-200 rounded-lg outline-none focus:border-sky-500 text-xs" placeholder="Direct Over the counter sale" />
      </div>

      <div class="pt-3 border-t border-slate-200 flex justify-end gap-2">
        <button type="button" onclick="closeNewInvoiceModal()" class="px-4 py-2 border border-slate-300 hover:bg-slate-50 rounded-lg text-xs font-medium text-slate-700">Cancel</button>
        <button type="submit" class="px-4 py-2 bg-[#0284c7] hover:bg-sky-700 text-white rounded-lg text-xs font-semibold shadow-xs">Generate Invoice</button>
      </div>
    </form>
  </div>
</div>

<script>
  function filterInvoiceTable() {
    const q = document.getElementById('invoiceSearchInput').value.toLowerCase();
    const status = document.getElementById('invoiceStatusFilter').value.toLowerCase();
    const rows = document.querySelectorAll('#invoicesTable tbody tr');

    rows.forEach(r => {
      const text = r.innerText.toLowerCase();
      const matchesQ = text.includes(q);
      const matchesStatus = status === 'all' || text.includes(status);
      r.style.display = matchesQ && matchesStatus ? '' : 'none';
    });
  }

  function openNewInvoiceModal() {
    document.getElementById('newInvoiceModal').classList.remove('hidden');
  }

  function closeNewInvoiceModal() {
    document.getElementById('newInvoiceModal').classList.add('hidden');
  }

  async function submitNewInvoice(e) {
    e.preventDefault();
    const payload = {
      name: document.getElementById('invCustName').value.trim(),
      mobile: document.getElementById('invMobile').value.trim(),
      store: document.getElementById('invStore').value,
      invoiceValue: parseFloat(document.getElementById('invAmount').value),
      salesPerson: document.getElementById('invSalesPerson').value.trim(),
      notes: document.getElementById('invNotes').value.trim()
    };

    try {
      const res = await fetch('/api/sales-invoices', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      } else {
        alert(data.error || 'Failed to create invoice');
      }
    } catch (err) {
      console.error(err);
      alert('Error creating invoice');
    }
  }

  function viewInvoiceDetails(no) {
    window.location.href = `/sales-invoice-reprint`;
  }

  function exportInvoices() {
    alert('Exporting invoices table to CSV/Excel format...');
  }
</script>
