<header class="fixed top-0 left-64 right-0 h-16 bg-surface/80 backdrop-blur-xl z-40 flex items-center justify-between px-space-lg border-b border-surface-container">
  <!-- Search Module Input -->
  <div class="relative flex items-center flex-1 max-w-md">
    <div class="flex items-center w-full bg-surface-container rounded-lg px-space-md py-1.5 focus-within:ring-2 focus-within:ring-secondary/40 transition-all">
      <span class="material-symbols-outlined text-on-surface-variant text-[18px] mr-2">search</span>
      <input 
        id="globalSearchInput" 
        class="bg-transparent border-none outline-none w-full text-body-md text-on-surface placeholder:text-on-surface-variant" 
        placeholder="Search modules, orders, customers..." 
        type="text"
        autocomplete="off"
      />
    </div>

    <!-- Live Search Dropdown -->
    <div id="globalSearchResults" class="hidden absolute top-12 left-0 right-0 bg-surface-container-lowest border border-outline-variant/30 rounded-xl shadow-xl z-50 max-h-80 overflow-y-auto divide-y divide-surface-container">
      <!-- Injected by JS -->
    </div>
  </div>

  <!-- Header Right Actions -->
  <div class="flex items-center gap-space-md">
    <button 
      id="quickCreateBtn"
      class="flex items-center gap-space-xs bg-secondary text-on-secondary px-space-md py-1.5 rounded-lg text-label-md hover:opacity-90 active:scale-95 transition-all shadow-sm"
    >
      <span class="material-symbols-outlined text-[16px]">add</span>
      Quick Create
    </button>

    <!-- Notifications Button -->
    <div class="relative">
      <button 
        id="notificationBtn"
        class="w-9 h-9 rounded-lg hover:bg-surface-container flex items-center justify-center text-on-surface-variant transition-colors relative"
        title="Notifications"
      >
        <span class="material-symbols-outlined text-[20px]">notifications</span>
        <span class="absolute top-1.5 right-1.5 w-2 h-2 bg-secondary rounded-full"></span>
      </button>

      <div id="notificationMenu" class="hidden absolute right-0 top-11 w-80 bg-surface-container-lowest border border-outline-variant/30 rounded-xl shadow-xl p-3 z-50">
        <div class="flex items-center justify-between pb-2 border-b border-surface-container">
          <span class="text-label-md font-semibold text-on-surface">Notifications</span>
          <span class="text-xs text-secondary font-medium">3 unread</span>
        </div>
        <div class="py-2 space-y-2 text-xs">
          <div class="p-2 rounded bg-surface-container-low">
            <p class="font-medium text-on-surface">New stock request REQ-2026-0891</p>
            <p class="text-on-surface-variant text-[11px]">North Hub → East Central</p>
          </div>
          <div class="p-2 rounded hover:bg-surface-container-low transition-colors">
            <p class="font-medium text-on-surface">Service Call SC-00003 unassigned</p>
            <p class="text-on-surface-variant text-[11px]">Bharat Electronics • Sony Soundbar</p>
          </div>
          <div class="p-2 rounded hover:bg-surface-container-low transition-colors">
            <p class="font-medium text-on-surface">Payment receipt #240260 created</p>
            <p class="text-on-surface-variant text-[11px]">Amount ₹12,500 by asdda</p>
          </div>
        </div>
      </div>
    </div>

    <!-- User Profile Dropdown -->
    <div class="flex items-center gap-2 pl-2 border-l border-surface-container">
      <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center cursor-pointer shadow-sm" title="Logged in as Admin">
        <span class="material-symbols-outlined text-on-primary text-[18px]">person</span>
      </div>
      <div class="hidden sm:flex flex-col">
        <span class="text-xs font-semibold text-on-surface leading-tight">Admin User</span>
        <span class="text-[10px] text-on-surface-variant leading-tight">Store Manager</span>
      </div>
    </div>
  </div>
</header>
