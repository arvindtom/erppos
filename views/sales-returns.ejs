<%- include('partials/head', { pageTitle: 'Sales Returns - ERPPOS' }) %>

<%- include('partials/sidebar') %>

<div class="pl-64 min-h-screen flex flex-col">
  <%- include('partials/header') %>

  <main class="relative pt-16 bg-surface p-space-lg flex-1">
    <div class="flex flex-col w-full">

      <!-- Top Section / Header -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-space-md mb-space-lg">
        <div>
          <h1 class="font-headline-lg text-on-surface">Sales Returns</h1>
          <p class="text-body-md text-on-surface-variant">Manage and track customer product returns, refunds, and store credits.</p>
        </div>
        <div class="flex items-center gap-space-sm flex-wrap">
          <button onclick="exportReturnsCSV()" class="flex items-center gap-space-xs px-space-md py-2 bg-surface-container-high text-on-surface rounded-lg hover:bg-surface-variant transition-colors text-label-md">
            <span class="material-symbols-outlined text-[18px]">download</span>
            Export
          </button>
          <button onclick="refreshReturns()" class="flex items-center gap-space-xs px-space-md py-2 bg-surface-container-high text-on-surface rounded-lg hover:bg-surface-variant transition-colors text-label-md">
            <span class="material-symbols-outlined text-[18px]">refresh</span>
            Refresh
          </button>
          <button onclick="openNewReturnModal()" class="flex items-center gap-space-xs px-space-md py-2 bg-secondary text-on-secondary rounded-lg hover:opacity-90 transition-opacity text-label-md shadow-sm">
            <span class="material-symbols-outlined text-[18px]">add</span>
            New Return
          </button>
        </div>
      </div>

      <!-- Filter Bar -->
      <div class="bg-surface-container-lowest p-space-md rounded-xl shadow-sm mb-space-lg flex flex-wrap items-center gap-space-md border border-outline-variant/20">
        <div class="flex items-center flex-1 min-w-[240px] bg-surface-container-low rounded-lg px-space-md py-1.5 border border-outline-variant/20">
          <span class="material-symbols-outlined text-on-surface-variant text-[18px] mr-2">search</span>
          <input 
            id="returnSearchInput" 
            class="bg-transparent border-none outline-none w-full text-body-md text-on-surface placeholder:text-on-surface-variant" 
            placeholder="Search by Return No., Customer, Mobile..." 
            type="text"
            oninput="filterReturnsTable()"
          />
        </div>

        <div class="flex items-center gap-space-xs bg-surface-container-low px-space-md py-1.5 rounded-lg text-body-md text-on-surface border border-outline-variant/20">
          <span class="material-symbols-outlined text-on-surface-variant text-[18px]">calendar_today</span>
          <input class="bg-transparent border-none outline-none w-24 text-center text-body-md" type="text" value="01-05-2026"/>
          <span class="text-on-surface-variant">to</span>
          <input class="bg-transparent border-none outline-none w-24 text-center text-body-md" type="text" value="03-07-2026"/>
        </div>

        <div class="flex items-center bg-surface-container-low px-space-md py-1.5 rounded-lg text-body-md text-on-surface border border-outline-variant/20">
          <span class="material-symbols-outlined text-on-surface-variant text-[18px] mr-2">store</span>
          <select id="returnStoreFilter" onchange="filterReturnsTable()" class="bg-transparent border-none outline-none text-body-md text-on-surface cursor-pointer">
            <option value="All Stores">All Stores</option>
            <option value="ARC1">ARC1 - ARC1</option>
            <option value="ARC2">ARC2 - ARC2</option>
          </select>
        </div>

        <div class="flex items-center bg-surface-container-low px-space-md py-1.5 rounded-lg text-body-md text-on-surface border border-outline-variant/20">
          <span class="material-symbols-outlined text-on-surface-variant text-[18px] mr-2">filter_list</span>
          <select id="returnStatusFilter" onchange="filterReturnsTable()" class="bg-transparent border-none outline-none text-body-md text-on-surface cursor-pointer">
            <option value="All Status">All Status</option>
            <option value="OPEN">Open</option>
            <option value="CLOSED">Closed</option>
            <option value="PENDING">Pending</option>
          </select>
        </div>
      </div>

      <!-- Data Table Container -->
      <div class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden mb-space-lg border border-outline-variant/20">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-surface-container-low text-on-surface-variant font-label-md text-label-md border-b border-surface-container">
                <th class="py-3 px-space-md">RETURN NO.</th>
                <th class="py-3 px-space-md">DATE</th>
                <th class="py-3 px-space-md">CUSTOMER CODE</th>
                <th class="py-3 px-space-md">CUSTOMER NAME</th>
                <th class="py-3 px-space-md">MOBILE</th>
                <th class="py-3 px-space-md">STORE</th>
                <th class="py-3 px-space-md text-right">GROSS TOTAL</th>
                <th class="py-3 px-space-md text-right">TAX AMOUNT</th>
                <th class="py-3 px-space-md text-right">DOC TOTAL</th>
                <th class="py-3 px-space-md text-center">STATUS</th>
                <th class="py-3 px-space-md">CREATED ON</th>
              </tr>
            </thead>
            <tbody id="returnsTableBody" class="divide-y divide-surface-container text-body-md text-on-surface">
              <% salesReturns.forEach(ret => { %>
                <tr class="hover:bg-surface-container-low transition-colors">
                  <td class="py-3 px-space-md font-label-md text-secondary">
                    <a href="javascript:void(0)" onclick="viewReturnSlip('<%= ret.returnNo %>')" class="hover:underline">
                      <%= ret.returnNo %>
                    </a>
                  </td>
                  <td class="py-3 px-space-md"><%= ret.date %></td>
                  <td class="py-3 px-space-md"><%= ret.customerCode %></td>
                  <td class="py-3 px-space-md font-medium"><%= ret.customerName %></td>
                  <td class="py-3 px-space-md text-on-surface-variant"><%= ret.mobile %></td>
                  <td class="py-3 px-space-md text-on-surface-variant"><%= ret.store %></td>
                  <td class="py-3 px-space-md text-right font-mono">₹<%= Number(ret.grossTotal).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                  <td class="py-3 px-space-md text-right font-mono">₹<%= Number(ret.taxAmount).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                  <td class="py-3 px-space-md text-right font-headline-sm font-mono">₹<%= Number(ret.docTotal).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                  <td class="py-3 px-space-md text-center">
                    <span class="inline-block px-2 py-0.5 bg-secondary-fixed text-on-secondary-fixed rounded text-label-sm font-label-sm font-semibold">
                      <%= ret.status %>
                    </span>
                  </td>
                  <td class="py-3 px-space-md text-on-surface-variant"><%= ret.createdOn %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <!-- Pagination Footer -->
        <div class="flex flex-col sm:flex-row items-center justify-between p-space-md bg-surface-container-lowest gap-space-md border-t border-surface-container">
          <div class="flex items-center gap-space-sm text-body-md text-on-surface-variant">
            <span id="returnsShowingText">Showing 1 to <%= Math.min(10, salesReturns.length) %> of <%= salesReturns.length %> entries</span>
            <div class="flex items-center ml-space-md">
              <span class="mr-2 text-xs">Rows:</span>
              <select class="bg-surface-container-low px-2 py-1 rounded text-on-surface outline-none text-xs">
                <option>10</option>
                <option>25</option>
                <option>50</option>
              </select>
            </div>
          </div>
          <div class="flex items-center gap-space-xs">
            <button class="w-8 h-8 flex items-center justify-center rounded bg-surface-container-low text-on-surface hover:bg-surface-container transition-colors disabled:opacity-50" disabled>
              <span class="material-symbols-outlined text-[18px]">chevron_left</span>
            </button>
            <button class="w-8 h-8 flex items-center justify-center rounded bg-secondary text-on-secondary text-label-md font-semibold">1</button>
            <button class="w-8 h-8 flex items-center justify-center rounded bg-surface-container-low text-on-surface hover:bg-surface-container transition-colors text-label-md">2</button>
            <button class="w-8 h-8 flex items-center justify-center rounded bg-surface-container-low text-on-surface hover:bg-surface-container transition-colors text-label-md">3</button>
            <button class="w-8 h-8 flex items-center justify-center rounded bg-surface-container-low text-on-surface hover:bg-surface-container transition-colors">
              <span class="material-symbols-outlined text-[18px]">chevron_right</span>
            </button>
          </div>
        </div>
      </div>

    </div>
  </main>
</div>

<!-- Modal: New Return -->
<div id="newReturnModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
  <div class="bg-surface-container-lowest rounded-2xl shadow-2xl w-full max-w-lg overflow-hidden border border-outline-variant/30">
    <div class="p-space-md bg-surface-container-low border-b border-surface-container flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-secondary">assignment_return</span>
        <h3 class="font-headline-sm text-on-surface">Process Sales Return</h3>
      </div>
      <button onclick="closeModal('newReturnModal')" class="p-1 rounded-lg hover:bg-surface-container text-on-surface-variant">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>

    <form id="newReturnForm" onsubmit="handleNewReturnSubmit(event)" class="p-space-lg space-y-space-md">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-sm">
        <div>
          <label class="text-label-sm text-on-surface-variant block mb-1">Customer Name *</label>
          <input required name="customerName" placeholder="e.g. JEYAPANDI" class="w-full bg-surface-container text-on-surface px-3 py-2 rounded-lg text-body-md border border-outline-variant/30 outline-none focus:border-secondary"/>
        </div>
        <div>
          <label class="text-label-sm text-on-surface-variant block mb-1">Mobile Number *</label>
          <input required name="mobile" placeholder="e.g. 9500716518" class="w-full bg-surface-container text-on-surface px-3 py-2 rounded-lg text-body-md border border-outline-variant/30 outline-none focus:border-secondary"/>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-sm">
        <div>
          <label class="text-label-sm text-on-surface-variant block mb-1">Store / Warehouse</label>
          <select name="store" class="w-full bg-surface-container text-on-surface px-3 py-2 rounded-lg text-body-md border border-outline-variant/30 outline-none">
            <option value="ARC1">ARC1 - Retail Store</option>
            <option value="ARC2">ARC2 - Hub Store</option>
          </select>
        </div>
        <div>
          <label class="text-label-sm text-on-surface-variant block mb-1">Gross Total (₹) *</label>
          <input required type="number" step="0.01" id="returnGrossInput" name="grossTotal" placeholder="10000.00" oninput="calculateReturnTotals()" class="w-full bg-surface-container text-on-surface px-3 py-2 rounded-lg text-body-md border border-outline-variant/30 outline-none focus:border-secondary"/>
        </div>
      </div>

      <!-- Computed Totals Preview -->
      <div class="bg-surface-container-low p-3 rounded-xl flex items-center justify-between text-body-sm">
        <div>Tax (12% GST): <strong id="previewTax" class="font-mono text-on-surface">₹0.00</strong></div>
        <div>Doc Total: <strong id="previewDocTotal" class="font-mono text-secondary text-base font-semibold">₹0.00</strong></div>
      </div>

      <div>
        <label class="text-label-sm text-on-surface-variant block mb-1">Returned Item & Reason</label>
        <input name="item" placeholder="e.g. Sony Soundbar - Defective audio" class="w-full bg-surface-container text-on-surface px-3 py-2 rounded-lg text-body-md border border-outline-variant/30 outline-none focus:border-secondary mb-2"/>
        <textarea name="reason" rows="2" placeholder="Detailed return notes or customer comments..." class="w-full bg-surface-container text-on-surface px-3 py-2 rounded-lg text-body-md border border-outline-variant/30 outline-none focus:border-secondary"></textarea>
      </div>

      <div class="flex items-center justify-end gap-space-sm pt-space-xs border-t border-surface-container">
        <button type="button" onclick="closeModal('newReturnModal')" class="px-space-md py-2 rounded-lg bg-surface-container text-on-surface text-label-md">Cancel</button>
        <button type="submit" class="px-space-md py-2 rounded-lg bg-secondary text-on-secondary text-label-md hover:opacity-90">Confirm Return</button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/modals') %>

<script src="/js/common.js"></script>
<script src="/js/returns.js"></script>
</body>
</html>
