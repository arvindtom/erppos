<%- include('partials/head', { pageTitle: 'Stock Requests - ERPPOS' }) %>

<%- include('partials/sidebar') %>

<div class="pl-64 min-h-screen flex flex-col">
  <%- include('partials/header') %>

  <main class="relative pt-16 bg-surface p-space-lg flex-1">
    <div class="flex flex-col w-full">

      <!-- Top Action & Title Bar -->
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-space-md mb-space-lg bg-surface-container-low p-space-lg rounded-xl shadow-sm border border-outline-variant/20">
        <div class="flex items-center gap-space-md">
          <div class="w-12 h-12 rounded-xl bg-secondary text-on-secondary flex items-center justify-center shadow-md">
            <span class="material-symbols-outlined text-[24px]" style="font-variation-settings: 'FILL' 1;">inventory_2</span>
          </div>
          <div>
            <div class="flex items-center gap-space-sm">
              <h1 class="text-headline-lg text-on-surface">Stock Requests</h1>
              <span id="activeReqBadge" class="bg-surface-container-high text-on-surface-variant px-space-sm py-0.5 rounded-full text-label-sm font-medium">
                <%= stockRequests.length %> active
              </span>
            </div>
            <p class="text-body-md text-on-surface-variant">Open requests between stores & regional distribution hubs</p>
          </div>
        </div>

        <div class="flex items-center gap-space-sm w-full md:w-auto justify-end">
          <button onclick="refreshStockRequests()" class="flex items-center gap-space-xs bg-surface-container-lowest text-on-surface hover:bg-surface-container px-space-md py-2 rounded-lg text-label-md transition-all shadow-sm">
            <span class="material-symbols-outlined text-[18px]">refresh</span>
            Refresh
          </button>
          <button onclick="openNewRequestModal()" class="flex items-center gap-space-xs bg-secondary text-on-secondary hover:opacity-90 px-space-md py-2 rounded-lg text-label-md transition-all shadow-sm">
            <span class="material-symbols-outlined text-[18px]">add</span>
            Add New Request
          </button>
        </div>
      </div>

      <!-- Filter Bar -->
      <div class="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm mb-space-lg border border-outline-variant/20">
        <form id="stockFilterForm" onsubmit="handleFilterSubmit(event)">
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 lg:grid-cols-8 gap-space-md mb-space-md">
            <!-- From Date -->
            <div class="flex flex-col gap-space-xs">
              <label class="text-label-sm text-on-surface-variant uppercase tracking-wider">From Date</label>
              <div class="flex items-center bg-surface-container-low rounded-lg px-space-sm h-9 border border-outline-variant/20">
                <input id="fromDate" class="bg-transparent text-body-md text-on-surface w-full outline-none" type="text" value="25-08-2026"/>
                <span class="material-symbols-outlined text-[18px] text-on-surface-variant">calendar_today</span>
              </div>
            </div>

            <!-- To Date -->
            <div class="flex flex-col gap-space-xs">
              <label class="text-label-sm text-on-surface-variant uppercase tracking-wider">To Date</label>
              <div class="flex items-center bg-surface-container-low rounded-lg px-space-sm h-9 border border-outline-variant/20">
                <input id="toDate" class="bg-transparent text-body-md text-on-surface w-full outline-none" type="text" value="24-09-2026"/>
                <span class="material-symbols-outlined text-[18px] text-on-surface-variant">calendar_today</span>
              </div>
            </div>

            <!-- From Store -->
            <div class="flex flex-col gap-space-xs">
              <label class="text-label-sm text-on-surface-variant uppercase tracking-wider">From Store</label>
              <select id="fromStoreFilter" class="bg-surface-container-low text-body-md text-on-surface rounded-lg px-space-sm h-9 outline-none cursor-pointer border border-outline-variant/20">
                <option value="All Stores">All Stores</option>
                <option value="North Hub">Store A - North Hub</option>
                <option value="East Central">Store B - East Central</option>
                <option value="South Depot">Store C - South Depot</option>
              </select>
            </div>

            <!-- To Store -->
            <div class="flex flex-col gap-space-xs">
              <label class="text-label-sm text-on-surface-variant uppercase tracking-wider">To Store</label>
              <select id="toStoreFilter" class="bg-surface-container-low text-body-md text-on-surface rounded-lg px-space-sm h-9 outline-none cursor-pointer border border-outline-variant/20">
                <option value="All Stores">All Stores</option>
                <option value="North Hub">Store A - North Hub</option>
                <option value="East Central">Store B - East Central</option>
                <option value="South Depot">Store C - South Depot</option>
              </select>
            </div>

            <!-- Trans Type -->
            <div class="flex flex-col gap-space-xs">
              <label class="text-label-sm text-on-surface-variant uppercase tracking-wider">Trans Type</label>
              <select id="transTypeFilter" class="bg-surface-container-low text-body-md text-on-surface rounded-lg px-space-sm h-9 outline-none cursor-pointer border border-outline-variant/20">
                <option value="All Types">All Types</option>
                <option value="Inter-Branch Transfer">Inter-Branch Transfer</option>
                <option value="Emergency Stock">Emergency Stock</option>
                <option value="Replenishment">Replenishment</option>
                <option value="Transfer">Transfer</option>
              </select>
            </div>

            <!-- Trans Status -->
            <div class="flex flex-col gap-space-xs">
              <label class="text-label-sm text-on-surface-variant uppercase tracking-wider">Trans Status</label>
              <select id="transStatusFilter" class="bg-surface-container-low text-body-md text-on-surface rounded-lg px-space-sm h-9 outline-none cursor-pointer border border-outline-variant/20">
                <option value="All Statuses">All Statuses</option>
                <option value="Pending">Pending</option>
                <option value="In Transit">In Transit</option>
                <option value="Completed">Completed</option>
                <option value="Cancelled">Cancelled</option>
              </select>
            </div>

            <!-- Approval -->
            <div class="flex flex-col gap-space-xs">
              <label class="text-label-sm text-on-surface-variant uppercase tracking-wider">Approval</label>
              <select id="approvalFilter" class="bg-surface-container-low text-body-md text-on-surface rounded-lg px-space-sm h-9 outline-none cursor-pointer border border-outline-variant/20">
                <option value="All">All</option>
                <option value="Approved">Approved</option>
                <option value="Waiting">Waiting Approval</option>
                <option value="Rejected">Rejected</option>
              </select>
            </div>

            <!-- Item Code -->
            <div class="flex flex-col gap-space-xs">
              <label class="text-label-sm text-on-surface-variant uppercase tracking-wider">Item Code</label>
              <input id="itemCodeFilter" class="bg-surface-container-low text-body-md text-on-surface rounded-lg px-space-sm h-9 outline-none placeholder:text-on-surface-variant/60 border border-outline-variant/20" placeholder="e.g. 500288" type="text"/>
            </div>
          </div>

          <!-- Filter Actions -->
          <div class="flex items-center gap-space-sm pt-space-sm border-t border-surface-container">
            <button type="submit" class="flex items-center gap-space-xs bg-secondary text-on-secondary px-space-lg py-2 rounded-lg text-label-md hover:opacity-90 transition-opacity shadow-sm">
              <span class="material-symbols-outlined text-[16px]">search</span>
              Search
            </button>
            <button type="button" onclick="clearFilters()" class="flex items-center gap-space-xs bg-surface-container text-on-surface px-space-lg py-2 rounded-lg text-label-md hover:bg-surface-container-high transition-colors">
              <span class="material-symbols-outlined text-[16px]">close</span>
              Clear
            </button>
          </div>
        </form>
      </div>

      <!-- Data Table Area -->
      <div class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden border border-outline-variant/20">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-surface-container-low text-on-surface-variant text-label-md border-b border-surface-container">
                <th class="py-space-md px-space-md font-semibold">Request ID</th>
                <th class="py-space-md px-space-md font-semibold">Date</th>
                <th class="py-space-md px-space-md font-semibold">From Store</th>
                <th class="py-space-md px-space-md font-semibold">To Store</th>
                <th class="py-space-md px-space-md font-semibold">Type</th>
                <th class="py-space-md px-space-md font-semibold">Items</th>
                <th class="py-space-md px-space-md font-semibold">Approval</th>
                <th class="py-space-md px-space-md font-semibold">Status</th>
                <th class="py-space-md px-space-md font-semibold text-right">Actions</th>
              </tr>
            </thead>
            <tbody id="stockTableBody" class="divide-y divide-surface-container text-body-md text-on-surface">
              <% stockRequests.forEach(req => { 
                  let appBadge = 'bg-tertiary-fixed text-on-tertiary-fixed';
                  if (req.approval === 'Approved') appBadge = 'bg-secondary-fixed text-on-secondary-fixed';
                  if (req.approval === 'Rejected') appBadge = 'bg-error-container text-on-error-container';

                  let statusBadge = 'bg-primary-fixed text-on-primary-fixed';
                  if (req.status === 'In Transit') statusBadge = 'bg-secondary-container text-on-secondary-container';
                  if (req.status === 'Completed') statusBadge = 'bg-emerald-100 text-emerald-800';
              %>
                <tr class="hover:bg-surface-container-low/50 transition-colors">
                  <td class="py-space-md px-space-md font-medium text-secondary">
                    <a href="javascript:void(0)" onclick="viewRequestDetails('<%= req.id %>')" class="hover:underline">
                      <%= req.id %>
                    </a>
                  </td>
                  <td class="py-space-md px-space-md"><%= req.date %></td>
                  <td class="py-space-md px-space-md"><%= req.fromStore %></td>
                  <td class="py-space-md px-space-md"><%= req.toStore %></td>
                  <td class="py-space-md px-space-md"><%= req.type %></td>
                  <td class="py-space-md px-space-md"><%= req.itemsCount %> items</td>
                  <td class="py-space-md px-space-md">
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-label-sm font-medium <%= appBadge %>">
                      <%= req.approval %>
                    </span>
                  </td>
                  <td class="py-space-md px-space-md">
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-label-sm font-medium <%= statusBadge %>">
                      <%= req.status %>
                    </span>
                  </td>
                  <td class="py-space-md px-space-md text-right">
                    <button onclick="viewRequestDetails('<%= req.id %>')" class="p-1 hover:bg-surface-container rounded text-on-surface-variant hover:text-on-surface transition-colors" title="View Details">
                      <span class="material-symbols-outlined text-[18px]">visibility</span>
                    </button>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <!-- Empty State Fallback -->
        <div id="stockEmptyState" class="hidden flex flex-col items-center justify-center py-16 px-space-lg text-center">
          <div class="w-16 h-16 rounded-full bg-surface-container flex items-center justify-center mb-space-md text-on-surface-variant">
            <span class="material-symbols-outlined text-[32px]">assignment_late</span>
          </div>
          <h3 class="text-headline-md text-on-surface mb-space-xs">No stock requests found</h3>
          <p class="text-body-md text-on-surface-variant max-w-sm">Try adjusting filters or create a new request using the button above.</p>
        </div>

        <!-- Pagination footer -->
        <div class="flex items-center justify-between px-space-lg py-space-md bg-surface-container-low border-t border-surface-container text-body-sm text-on-surface-variant">
          <div>Showing <span id="showingCount" class="font-medium text-on-surface">1-<%= stockRequests.length %></span> of <span id="totalCount" class="font-medium text-on-surface"><%= stockRequests.length %></span> requests</div>
          <div class="flex items-center gap-space-xs">
            <button class="px-space-sm py-1 rounded bg-surface-container-lowest text-on-surface disabled:opacity-40" disabled>Previous</button>
            <button class="px-space-sm py-1 rounded bg-secondary text-on-secondary font-medium">1</button>
            <button class="px-space-sm py-1 rounded bg-surface-container-lowest text-on-surface hover:bg-surface-container">2</button>
            <button class="px-space-sm py-1 rounded bg-surface-container-lowest text-on-surface hover:bg-surface-container">Next</button>
          </div>
        </div>
      </div>

    </div>
  </main>
</div>

<!-- Modal: Add New Stock Request -->
<div id="newRequestModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
  <div class="bg-surface-container-lowest rounded-2xl shadow-2xl w-full max-w-lg overflow-hidden border border-outline-variant/30">
    <div class="p-space-md bg-surface-container-low border-b border-surface-container flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-secondary">inventory_2</span>
        <h3 class="font-headline-sm text-on-surface">Add New Stock Request</h3>
      </div>
      <button onclick="closeModal('newRequestModal')" class="p-1 rounded-lg hover:bg-surface-container text-on-surface-variant">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>

    <form id="newRequestForm" onsubmit="handleNewStockRequestSubmit(event)" class="p-space-lg space-y-space-md">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-sm">
        <div>
          <label class="text-label-sm text-on-surface-variant block mb-1">From Store *</label>
          <select required name="fromStore" class="w-full bg-surface-container text-on-surface px-3 py-2 rounded-lg text-body-md border border-outline-variant/30 outline-none">
            <option value="North Hub (WH-01)">North Hub (WH-01)</option>
            <option value="South Depot (WH-03)">South Depot (WH-03)</option>
            <option value="East Central (ST-04)">East Central (ST-04)</option>
          </select>
        </div>
        <div>
          <label class="text-label-sm text-on-surface-variant block mb-1">To Store *</label>
          <select required name="toStore" class="w-full bg-surface-container text-on-surface px-3 py-2 rounded-lg text-body-md border border-outline-variant/30 outline-none">
            <option value="East Central (ST-04)">East Central (ST-04)</option>
            <option value="North Hub (WH-01)">North Hub (WH-01)</option>
            <option value="South Depot (WH-03)">South Depot (WH-03)</option>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-sm">
        <div>
          <label class="text-label-sm text-on-surface-variant block mb-1">Transaction Type</label>
          <select name="type" class="w-full bg-surface-container text-on-surface px-3 py-2 rounded-lg text-body-md border border-outline-variant/30 outline-none">
            <option value="Inter-Branch Transfer">Inter-Branch Transfer</option>
            <option value="Emergency Stock">Emergency Stock</option>
            <option value="Replenishment">Replenishment</option>
          </select>
        </div>
        <div>
          <label class="text-label-sm text-on-surface-variant block mb-1">Sample Item & Quantity</label>
          <input name="sampleItem" placeholder="e.g. Samsung S20FE Case (Qty 20)" class="w-full bg-surface-container text-on-surface px-3 py-2 rounded-lg text-body-md border border-outline-variant/30 outline-none"/>
        </div>
      </div>

      <div>
        <label class="text-label-sm text-on-surface-variant block mb-1">Notes / Remarks</label>
        <textarea name="notes" rows="2" placeholder="Urgent transfer for store replenishment..." class="w-full bg-surface-container text-on-surface px-3 py-2 rounded-lg text-body-md border border-outline-variant/30 outline-none"></textarea>
      </div>

      <div class="flex items-center justify-end gap-space-sm pt-space-xs border-t border-surface-container">
        <button type="button" onclick="closeModal('newRequestModal')" class="px-space-md py-2 rounded-lg bg-surface-container text-on-surface text-label-md">Cancel</button>
        <button type="submit" class="px-space-md py-2 rounded-lg bg-secondary text-on-secondary text-label-md hover:opacity-90">Create Request</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal: View Stock Request Details & Approval -->
<div id="requestDetailsModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
  <div class="bg-surface-container-lowest rounded-2xl shadow-2xl w-full max-w-xl overflow-hidden border border-outline-variant/30">
    <div class="p-space-md bg-surface-container-low border-b border-surface-container flex items-center justify-between">
      <div>
        <h3 id="detailReqId" class="font-headline-md text-secondary">REQ-2026-0891</h3>
        <p id="detailReqSubtitle" class="text-xs text-on-surface-variant">Transfer Request Details</p>
      </div>
      <button onclick="closeModal('requestDetailsModal')" class="p-1 rounded-lg hover:bg-surface-container text-on-surface-variant">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>

    <div class="p-space-lg space-y-space-md">
      <div class="grid grid-cols-2 gap-space-sm bg-surface-container-low p-3 rounded-xl text-body-sm">
        <div><span class="text-on-surface-variant">From:</span> <strong id="detailFromStore" class="text-on-surface">North Hub</strong></div>
        <div><span class="text-on-surface-variant">To:</span> <strong id="detailToStore" class="text-on-surface">East Central</strong></div>
        <div><span class="text-on-surface-variant">Date:</span> <span id="detailDate" class="text-on-surface">26-08-2026</span></div>
        <div><span class="text-on-surface-variant">Approval:</span> <span id="detailApprovalBadge" class="font-semibold">Waiting</span></div>
      </div>

      <div>
        <h4 class="text-label-md text-on-surface font-semibold mb-2">Requested Items:</h4>
        <div id="detailItemsList" class="space-y-1.5 max-h-48 overflow-y-auto border border-surface-container rounded-lg p-2 bg-surface-container-low/40">
          <!-- Dynamically populated -->
        </div>
      </div>

      <!-- Action buttons: Approve / Reject / Dispatch -->
      <div id="approvalActionGroup" class="flex items-center justify-between pt-space-sm border-t border-surface-container">
        <div class="flex items-center gap-2">
          <button id="btnApprove" class="px-3 py-1.5 rounded-lg bg-secondary text-on-secondary text-xs font-semibold hover:opacity-90">
            Approve Request
          </button>
          <button id="btnReject" class="px-3 py-1.5 rounded-lg bg-error-container text-on-error-container text-xs font-semibold hover:opacity-90">
            Reject
          </button>
        </div>
        <button id="btnDispatch" class="px-3 py-1.5 rounded-lg bg-surface-container-highest text-on-surface text-xs font-semibold hover:bg-surface-container">
          Mark In Transit
        </button>
      </div>
    </div>
  </div>
</div>

<%- include('partials/modals') %>

<script src="/js/common.js"></script>
<script src="/js/stock.js"></script>
</body>
</html>
