<%- include('partials/head', { pageTitle: 'Technician Assignment - ERPPOS' }) %>

<%- include('partials/sidebar') %>

<div class="pl-64 min-h-screen flex flex-col bg-slate-50">
  <%- include('partials/header') %>

  <main class="relative pt-28 px-6 pb-12 flex-1">
    <div class="w-full space-y-4">

      <!-- Top Header matching screenshot media_1790274409440.png -->
      <div class="bg-white p-4 rounded-xl border border-slate-200/80 shadow-xs flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-sky-500 text-white flex items-center justify-center shadow-xs">
            <span class="material-symbols-outlined text-[22px]">group</span>
          </div>
          <div>
            <h1 class="text-base font-bold text-slate-800">Technician Assignment</h1>
            <p class="text-xs text-slate-500 font-medium">Drag open calls onto a technician to assign</p>
          </div>
        </div>

        <div>
          <button onclick="window.location.reload()" class="w-9 h-9 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 flex items-center justify-center text-slate-600 transition-colors shadow-xs" title="Refresh">
            <span class="material-symbols-outlined text-[18px]">sync</span>
          </button>
        </div>
      </div>

      <!-- 3-Column Kanban Board matching screenshot media_1790274409440.png -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 items-start">

        <!-- Column 1: Open Calls (1) -->
        <div class="space-y-3">
          <h2 class="text-xs font-bold text-slate-700">Open Calls (<span id="openCount"><%= (openCalls || []).length %></span>)</h2>

          <div id="openCallsContainer" class="space-y-2.5 min-h-[350px] p-2 rounded-xl bg-slate-100/60 border border-dashed border-slate-200">
            <% (openCalls || []).forEach(call => { %>
              <div 
                id="call-<%= call.id %>"
                draggable="true" 
                ondragstart="handleDragStart(event, '<%= call.id %>')"
                class="bg-white p-3.5 rounded-xl border border-slate-200 shadow-xs hover:shadow-md transition-all cursor-grab active:cursor-grabbing space-y-1.5"
              >
                <div class="flex items-center justify-between">
                  <span class="font-mono text-xs font-semibold text-sky-600 hover:underline cursor-pointer"><%= call.id %></span>
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-sky-100 text-sky-700 border border-sky-200">
                    <%= call.priority || 'Medium' %>
                  </span>
                </div>
                <p class="font-bold text-xs text-slate-800"><%= call.customer %></p>
                <p class="text-[11px] text-slate-500"><%= call.device || call.item %> • <%= call.issue || call.problem %></p>

                <!-- Quick Assign Dropdown -->
                <div class="pt-1.5 flex items-center gap-1.5">
                  <select onchange="assignFromDropdown('<%= call.id %>', this.value)" class="w-full bg-slate-50 border border-slate-200 rounded px-2 py-1 text-[11px] text-slate-700 outline-none">
                    <option value="">Assign to Tech...</option>
                    <% (technicians || []).forEach(t => { %>
                      <option value="<%= t.id %>"><%= t.name %> (<%= t.specialty %>)</option>
                    <% }); %>
                  </select>
                </div>
              </div>
            <% }); %>

            <% if ((openCalls || []).length === 0) { %>
              <div class="p-6 text-center text-xs text-slate-400">No open calls awaiting assignment</div>
            <% } %>
          </div>
        </div>

        <!-- Column 2: Technicians (4) -->
        <div class="space-y-3">
          <h2 class="text-xs font-bold text-slate-700">Technicians (<%= (technicians || []).length %>)</h2>

          <div class="space-y-2.5">
            <% (technicians || []).forEach(t => { 
                let isAvail = t.status === 'Available';
            %>
              <div 
                id="tech-<%= t.id %>"
                ondragover="handleDragOver(event)" 
                ondrop="handleDrop(event, '<%= t.id %>')"
                class="bg-white p-3.5 rounded-xl border border-slate-200 shadow-xs hover:border-sky-400 transition-all space-y-1.5"
              >
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-[17px] text-slate-500">person</span>
                    <span class="font-bold text-xs text-slate-800"><%= t.name %></span>
                  </div>
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold <%= isAvail ? 'bg-emerald-100 text-emerald-800 border border-emerald-200' : 'bg-amber-100 text-amber-800 border border-amber-200' %>">
                    <%= t.status %>
                  </span>
                </div>
                <p class="text-[11px] text-slate-500"><%= t.specialty %> • <%= t.phone %></p>
                <p class="text-[10px] text-slate-400 font-mono">Today Assigned: <%= t.assignedToday || 0 %> | Closed: <%= t.closedToday || 0 %></p>
              </div>
            <% }); %>
          </div>
        </div>

        <!-- Column 3: Assigned Calls (2) -->
        <div class="space-y-3">
          <h2 class="text-xs font-bold text-slate-700">Assigned Calls (<span id="assignedCount"><%= (assignedCalls || []).length %></span>)</h2>

          <div id="assignedCallsContainer" class="space-y-2.5">
            <% (assignedCalls || []).forEach(call => { 
                let statusClass = 'bg-sky-100 text-sky-700 border-sky-200';
                if (call.status === 'In Progress') statusClass = 'bg-amber-100 text-amber-800 border-amber-200';
                if (call.status === 'Pending Spare') statusClass = 'bg-purple-100 text-purple-800 border-purple-200';
                if (call.status === 'Resolved') statusClass = 'bg-emerald-100 text-emerald-800 border-emerald-200';
            %>
              <div class="bg-white p-3.5 rounded-xl border border-slate-200 shadow-xs space-y-1.5">
                <div class="flex items-center justify-between">
                  <span class="font-mono text-xs font-semibold text-sky-600 hover:underline cursor-pointer"><%= call.id %></span>
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold border <%= statusClass %>">
                    <%= call.status %>
                  </span>
                </div>
                <p class="font-bold text-xs text-slate-800"><%= call.customer %></p>
                <div class="flex items-center justify-between text-[11px] text-slate-600 pt-1 border-t border-slate-100">
                  <span class="font-medium text-slate-700">→ <%= call.technicianName || call.technician %></span>
                  <button onclick="unassignCall('<%= call.id %>')" class="text-[10px] text-slate-400 hover:text-red-600">Reassign</button>
                </div>
              </div>
            <% }); %>
          </div>
        </div>

      </div>

    </div>
  </main>
</div>

<script>
  let draggedCallId = null;

  function handleDragStart(e, callId) {
    draggedCallId = callId;
    e.dataTransfer.setData('text/plain', callId);
  }

  function handleDragOver(e) {
    e.preventDefault();
  }

  async function handleDrop(e, techId) {
    e.preventDefault();
    if (!draggedCallId) return;
    await assignCall(draggedCallId, techId);
  }

  async function assignFromDropdown(callId, techId) {
    if (!techId) return;
    await assignCall(callId, techId);
  }

  async function assignCall(callId, techId) {
    try {
      const res = await fetch(`/api/technicians/assign`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ callId, technicianId: techId })
      });
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      } else {
        alert(data.error || 'Assignment failed');
      }
    } catch (err) {
      console.error(err);
      alert('Error assigning call');
    }
  }

  async function unassignCall(callId) {
    try {
      const res = await fetch(`/api/technicians/unassign`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ callId })
      });
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      }
    } catch (err) {
      console.error(err);
    }
  }
</script>
