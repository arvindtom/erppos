<%- include('partials/head', { pageTitle: 'Check Item Price & Stock - ERPPOS' }) %>

<%- include('partials/sidebar') %>

<div class="pl-64 min-h-screen flex flex-col">
  <%- include('partials/header') %>

  <main class="relative pt-16 bg-surface p-space-lg flex-1">
    <div class="flex flex-col w-full">

      <!-- Top Bar / Title -->
      <div class="flex items-center justify-between mb-space-lg">
        <div class="flex items-center gap-space-md">
          <span class="material-symbols-outlined text-[28px] text-primary">inventory_2</span>
          <h1 class="font-headline-lg text-on-surface">Check Item Price &amp; Stock</h1>
        </div>
        <div class="flex items-center gap-space-sm bg-surface-container-high px-space-md py-space-xs rounded-full">
          <span class="text-body-sm text-on-surface-variant">Showing</span>
          <span id="itemsBadgeCount" class="bg-secondary text-on-secondary px-2 py-0.5 rounded-full text-label-sm font-bold"><%= items.length %></span>
          <span class="text-body-sm text-on-surface-variant">loaded records</span>
        </div>
      </div>

      <!-- Filters Toolbar -->
      <div class="bg-surface-container-lowest p-space-md rounded-xl shadow-sm mb-space-lg flex flex-wrap items-center gap-space-md border border-outline-variant/20">
        <div class="flex flex-col flex-1 min-w-[200px]">
          <label class="text-label-sm text-on-surface-variant mb-space-xs">Store / Warehouse</label>
          <div class="flex items-center bg-surface-container px-space-md py-2 rounded-lg border border-outline-variant/30">
            <span class="material-symbols-outlined text-[18px] text-on-surface-variant mr-2">store</span>
            <select id="itemStoreFilter" onchange="filterItems()" class="bg-transparent border-none outline-none w-full text-body-md text-on-surface cursor-pointer">
              <option value="All Stores">All Stores</option>
              <option value="ARC1" selected>ARC1 — ARC1</option>
              <option value="ARC2">ARC2 — Warehouse North</option>
              <option value="MAIN">MAIN — Central Hub</option>
            </select>
          </div>
        </div>

        <div class="flex flex-col flex-1 min-w-[160px]">
          <label class="text-label-sm text-on-surface-variant mb-space-xs">Brand</label>
          <div class="flex items-center bg-surface-container px-space-md py-2 rounded-lg border border-outline-variant/30">
            <select id="itemBrandFilter" onchange="filterItems()" class="bg-transparent border-none outline-none w-full text-body-md text-on-surface cursor-pointer">
              <option value="All Brands">All Brands</option>
              <option value="Onsitego">Onsitego</option>
              <option value="Y.N Back Case">Y.N Back Case</option>
              <option value="Samsung">Samsung</option>
              <option value="Apple">Apple</option>
              <option value="Sony">Sony</option>
              <option value="LG">LG</option>
            </select>
          </div>
        </div>

        <div class="flex flex-col flex-1 min-w-[160px]">
          <label class="text-label-sm text-on-surface-variant mb-space-xs">Category</label>
          <div class="flex items-center bg-surface-container px-space-md py-2 rounded-lg border border-outline-variant/30">
            <select id="itemCategoryFilter" onchange="filterItems()" class="bg-transparent border-none outline-none w-full text-body-md text-on-surface cursor-pointer">
              <option value="All Categories">All Categories</option>
              <option value="Insurance">Insurance</option>
              <option value="General Accessories">General Accessories</option>
              <option value="Smartphones">Smartphones</option>
              <option value="Spare Parts">Spare Parts</option>
              <option value="Air Conditioners">Air Conditioners</option>
            </select>
          </div>
        </div>

        <div class="flex flex-col flex-[2] min-w-[240px]">
          <label class="text-label-sm text-on-surface-variant mb-space-xs">Search</label>
          <div class="flex items-center bg-surface-container px-space-md py-2 rounded-lg border border-outline-variant/30">
            <span class="material-symbols-outlined text-[18px] text-on-surface-variant mr-2">search</span>
            <input 
              id="itemSearchInput" 
              oninput="filterItems()" 
              class="bg-transparent border-none outline-none w-full text-body-md text-on-surface placeholder:text-on-surface-variant" 
              placeholder="Item Code, Name, Brand..." 
              type="text"
            />
          </div>
        </div>

        <div class="flex items-end gap-space-sm pt-5">
          <button onclick="clearItemFilters()" class="flex items-center gap-space-xs px-space-md py-2 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface text-label-md transition-colors">
            <span class="material-symbols-outlined text-[16px]">close</span>
            Clear Filters
          </button>
          <button onclick="openColumnsModal()" class="flex items-center gap-space-xs px-space-md py-2 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface text-label-md transition-colors">
            <span class="material-symbols-outlined text-[16px]">view_column</span>
            Columns
          </button>
          <button onclick="refreshItems()" class="flex items-center gap-space-xs px-space-md py-2 rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface text-label-md transition-colors">
            <span class="material-symbols-outlined text-[16px]">refresh</span>
            Refresh
          </button>
          <button onclick="exportItemsCSV()" class="flex items-center gap-space-xs px-space-md py-2 rounded-lg bg-primary text-on-primary text-label-md hover:opacity-90 transition-opacity shadow-sm">
            <span class="material-symbols-outlined text-[16px]">download</span>
            Export Excel
          </button>
        </div>
      </div>

      <!-- Data Table Container -->
      <div class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden flex flex-col mb-space-lg border border-outline-variant/20">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse" id="itemsTable">
            <thead>
              <tr class="bg-surface-container-low text-on-surface-variant text-label-md border-b border-surface-container select-none">
                <th class="py-3 px-4 font-semibold cursor-pointer" onclick="sortTable(0)">ITEM CODE <span class="material-symbols-outlined text-[14px] align-middle">unfold_more</span></th>
                <th class="py-3 px-4 font-semibold cursor-pointer" onclick="sortTable(1)">ITEM NAME <span class="material-symbols-outlined text-[14px] align-middle">unfold_more</span></th>
                <th class="py-3 px-4 font-semibold cursor-pointer" onclick="sortTable(2)">BRAND <span class="material-symbols-outlined text-[14px] align-middle">unfold_more</span></th>
                <th class="py-3 px-4 font-semibold cursor-pointer" onclick="sortTable(3)">CATEGORY <span class="material-symbols-outlined text-[14px] align-middle">unfold_more</span></th>
                <th class="py-3 px-4 font-semibold">UOM <span class="material-symbols-outlined text-[14px] align-middle">unfold_more</span></th>
                <th class="py-3 px-4 font-semibold">PRICELIST <span class="material-symbols-outlined text-[14px] align-middle">unfold_more</span></th>
                <th class="py-3 px-4 font-semibold text-right cursor-pointer" onclick="sortTable(6, true)">PRICE (₹) <span class="material-symbols-outlined text-[14px] align-middle">unfold_more</span></th>
                <th class="py-3 px-4 font-semibold text-right">ON HAND <span class="material-symbols-outlined text-[14px] align-middle">unfold_more</span></th>
                <th class="py-3 px-4 font-semibold text-right">RESERVED <span class="material-symbols-outlined text-[14px] align-middle">unfold_more</span></th>
                <th class="py-3 px-4 font-semibold text-right cursor-pointer" onclick="sortTable(9, true)">AVAILABLE <span class="material-symbols-outlined text-[14px] align-middle">unfold_more</span></th>
                <th class="py-3 px-4 font-semibold text-center">STATUS <span class="material-symbols-outlined text-[14px] align-middle">unfold_more</span></th>
              </tr>
            </thead>
            <tbody id="itemsTableBody" class="divide-y divide-surface-container text-body-md text-on-surface">
              <% items.forEach(item => { 
                  const isAvailableZero = Number(item.available) === 0;
              %>
                <tr class="hover:bg-surface-container-low/50 transition-colors">
                  <td class="py-3 px-4 text-secondary font-medium"><%= item.code %></td>
                  <td class="py-3 px-4 font-medium"><%= item.name %></td>
                  <td class="py-3 px-4 text-on-surface-variant"><%= item.brand %></td>
                  <td class="py-3 px-4 text-on-surface-variant"><%= item.category %></td>
                  <td class="py-3 px-4 text-on-surface-variant"><%= item.uom %></td>
                  <td class="py-3 px-4 text-on-surface-variant font-mono"><%= item.pricelist %></td>
                  <td class="py-3 px-4 text-right font-mono">₹<%= Number(item.price).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                  <td class="py-3 px-4 text-right font-mono"><%= item.onHand %></td>
                  <td class="py-3 px-4 text-right font-mono"><%= item.reserved %></td>
                  <td class="py-3 px-4 text-right font-mono">
                    <% if (isAvailableZero) { %>
                      <span class="bg-error text-on-error px-2 py-0.5 rounded text-label-sm font-bold">0</span>
                    <% } else { %>
                      <span class="bg-secondary text-on-secondary px-2 py-0.5 rounded text-label-sm font-bold"><%= item.available %></span>
                    <% } %>
                  </td>
                  <td class="py-3 px-4 text-center text-on-surface-variant"><%= item.status %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <!-- Pagination Footer -->
        <div class="flex items-center justify-between p-space-md border-t border-surface-container bg-surface-container-low/30">
          <div class="flex items-center gap-space-sm">
            <span class="text-body-sm text-on-surface-variant">Rows per page</span>
            <select class="bg-surface-container px-2 py-1 rounded border border-outline-variant/30 text-body-sm text-on-surface">
              <option>50</option>
              <option>100</option>
              <option>250</option>
            </select>
          </div>
          <div class="text-body-sm text-on-surface-variant">
            Showing <span class="font-medium text-on-surface">1–<%= items.length %></span> of <span class="font-medium text-on-surface">5,732</span>
          </div>
          <div class="flex items-center gap-space-xs">
            <button class="w-8 h-8 rounded bg-surface-container flex items-center justify-center text-on-surface hover:bg-surface-container-high transition-colors disabled:opacity-50" disabled>
              <span class="material-symbols-outlined text-[16px]">first_page</span>
            </button>
            <button class="w-8 h-8 rounded bg-surface-container flex items-center justify-center text-on-surface hover:bg-surface-container-high transition-colors disabled:opacity-50" disabled>
              <span class="material-symbols-outlined text-[16px]">chevron_left</span>
            </button>
            <span class="text-body-sm text-on-surface px-space-xs font-medium">Page 1 of 115</span>
            <button class="w-8 h-8 rounded bg-surface-container flex items-center justify-center text-on-surface hover:bg-surface-container-high transition-colors">
              <span class="material-symbols-outlined text-[16px]">chevron_right</span>
            </button>
            <button class="w-8 h-8 rounded bg-surface-container flex items-center justify-center text-on-surface hover:bg-surface-container-high transition-colors">
              <span class="material-symbols-outlined text-[16px]">last_page</span>
            </button>
          </div>
        </div>
      </div>

    </div>
  </main>
</div>

<!-- Modal: Columns Visibility Toggle -->
<div id="columnsModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
  <div class="bg-surface-container-lowest rounded-2xl shadow-2xl w-full max-w-sm p-space-md border border-outline-variant/30">
    <div class="flex items-center justify-between pb-2 border-b border-surface-container">
      <h3 class="font-headline-sm text-on-surface">Visible Columns</h3>
      <button onclick="closeModal('columnsModal')" class="p-1 text-on-surface-variant hover:bg-surface-container rounded-lg">
        <span class="material-symbols-outlined text-[18px]">close</span>
      </button>
    </div>
    <div class="py-3 space-y-2 text-sm">
      <label class="flex items-center gap-2 cursor-pointer"><input type="checkbox" checked disabled class="accent-secondary"/> Item Code</label>
      <label class="flex items-center gap-2 cursor-pointer"><input type="checkbox" checked disabled class="accent-secondary"/> Item Name</label>
      <label class="flex items-center gap-2 cursor-pointer"><input type="checkbox" checked class="accent-secondary"/> Brand</label>
      <label class="flex items-center gap-2 cursor-pointer"><input type="checkbox" checked class="accent-secondary"/> Category</label>
      <label class="flex items-center gap-2 cursor-pointer"><input type="checkbox" checked class="accent-secondary"/> Price (₹)</label>
      <label class="flex items-center gap-2 cursor-pointer"><input type="checkbox" checked class="accent-secondary"/> On Hand</label>
      <label class="flex items-center gap-2 cursor-pointer"><input type="checkbox" checked class="accent-secondary"/> Available</label>
    </div>
    <div class="flex justify-end pt-2 border-t border-surface-container">
      <button onclick="closeModal('columnsModal')" class="px-3 py-1.5 bg-secondary text-on-secondary text-xs rounded-lg font-medium">Apply</button>
    </div>
  </div>
</div>

<%- include('partials/modals') %>

<script src="/js/common.js"></script>
<script src="/js/items.js"></script>
</body>
</html>
