<%- include('partials/head', { pageTitle: 'Sales Orders - ERPPOS' }) %>

<%- include('partials/sidebar') %>

<div class="pl-64 min-h-screen flex flex-col">
  <%- include('partials/header') %>

  <main class="relative pt-16 bg-surface p-space-lg flex-1">
    <div class="flex flex-col w-full">

      <!-- Top Title & Action Header -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-space-md mb-space-lg">
        <div class="flex items-center gap-space-md">
          <div class="w-10 h-10 rounded-xl bg-secondary text-on-secondary flex items-center justify-center shadow-sm">
            <span class="material-symbols-outlined text-[24px]">shopping_cart</span>
          </div>
          <div>
            <h1 class="font-headline-lg text-on-surface">Sales Orders</h1>
            <p class="text-body-md text-on-surface-variant">Create and track retail and wholesale customer sales orders</p>
          </div>
        </div>

        <div class="flex items-center gap-space-sm flex-wrap">
          <button onclick="exportOrdersCSV()" class="flex items-center gap-space-xs px-space-md py-2 bg-surface-container-high text-on-surface rounded-lg hover:bg-surface-variant transition-colors text-label-md">
            <span class="material-symbols-outlined text-[18px]">download</span>
            Export
          </button>
          <button onclick="location.reload()" class="flex items-center gap-space-xs px-space-md py-2 bg-surface-container-high text-on-surface rounded-lg hover:bg-surface-variant transition-colors text-label-md">
            <span class="material-symbols-outlined text-[18px]">refresh</span>
            Refresh
          </button>
          <button onclick="openNewOrderModal()" class="flex items-center gap-space-xs px-space-md py-2 bg-secondary text-on-secondary rounded-lg hover:opacity-90 transition-opacity text-label-md shadow-sm">
            <span class="material-symbols-outlined text-[18px]">add</span>
            New Sales Order
          </button>
        </div>
      </div>

      <!-- Filter Bar -->
      <div class="bg-surface-container-lowest p-space-md rounded-xl shadow-sm mb-space-lg flex flex-wrap items-center gap-space-md border border-outline-variant/20">
        <div class="flex items-center flex-1 min-w-[240px] bg-surface-container-low rounded-lg px-space-md py-1.5 border border-outline-variant/20">
          <span class="material-symbols-outlined text-on-surface-variant text-[18px] mr-2">search</span>
          <input 
            id="orderSearchInput" 
            class="bg-transparent border-none outline-none w-full text-body-md text-on-surface placeholder:text-on-surface-variant" 
            placeholder="Search by Order No., Customer, Mobile..." 
            type="text"
            oninput="filterOrdersTable()"
          />
        </div>

        <div class="flex items-center bg-surface-container-low px-space-md py-1.5 rounded-lg text-body-md text-on-surface border border-outline-variant/20">
          <span class="material-symbols-outlined text-on-surface-variant text-[18px] mr-2">store</span>
          <select id="orderStoreFilter" onchange="filterOrdersTable()" class="bg-transparent border-none outline-none text-body-md text-on-surface cursor-pointer">
            <option value="All Stores">All Stores</option>
            <option value="ARC1">ARC1</option>
            <option value="ARC2">ARC2</option>
          </select>
        </div>

        <div class="flex items-center bg-surface-container-low px-space-md py-1.5 rounded-lg text-body-md text-on-surface border border-outline-variant/20">
          <span class="material-symbols-outlined text-on-surface-variant text-[18px] mr-2">filter_list</span>
          <select id="orderStatusFilter" onchange="filterOrdersTable()" class="bg-transparent border-none outline-none text-body-md text-on-surface cursor-pointer">
            <option value="All Status">All Status</option>
            <option value="Confirmed">Confirmed</option>
            <option value="Pending">Pending</option>
            <option value="Delivered">Delivered</option>
          </select>
        </div>
      </div>

      <!-- Data Table Container -->
      <div class="bg-surface-container-lowest rounded-xl shadow-sm overflow-hidden mb-space-lg border border-outline-variant/20">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-surface-container-low text-on-surface-variant font-label-md text-label-md border-b border-surface-container">
                <th class="py-3 px-space-md">ORDER NO.</th>
                <th class="py-3 px-space-md">DATE</th>
                <th class="py-3 px-space-md">CUSTOMER</th>
                <th class="py-3 px-space-md">MOBILE</th>
                <th class="py-3 px-space-md">STORE</th>
                <th class="py-3 px-space-md">DELIVERY</th>
                <th class="py-3 px-space-md text-right">GROSS TOTAL</th>
                <th class="py-3 px-space-md text-right">DOC TOTAL</th>
                <th class="py-3 px-space-md text-center">STATUS</th>
                <th class="py-3 px-space-md text-right">ACTIONS</th>
              </tr>
            </thead>
            <tbody id="ordersTableBody" class="divide-y divide-surface-container text-body-md text-on-surface">
              <% (salesOrders || []).forEach(o => { 
                  let statusBadge = 'bg-secondary-fixed text-on-secondary-fixed';
                  if (o.status === 'Pending') statusBadge = 'bg-amber-100 text-amber-800';
                  if (o.status === 'Delivered') statusBadge = 'bg-emerald-100 text-emerald-800';
              %>
                <tr class="hover:bg-surface-container-low transition-colors">
                  <td class="py-3 px-space-md font-label-md text-secondary font-mono font-medium">
                    <a href="javascript:void(0)" onclick="viewOrderSlip('<%= o.orderNo %>')" class="hover:underline">
                      <%= o.orderNo %>
                    </a>
                  </td>
                  <td class="py-3 px-space-md"><%= o.date %></td>
                  <td class="py-3 px-space-md font-medium"><%= o.customerName %></td>
                  <td class="py-3 px-space-md text-on-surface-variant"><%= o.mobile %></td>
                  <td class="py-3 px-space-md text-on-surface-variant"><%= o.store %></td>
                  <td class="py-3 px-space-md text-on-surface-variant"><%= o.deliveryDate %></td>
                  <td class="py-3 px-space-md text-right font-mono">₹<%= Number(o.grossTotal).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                  <td class="py-3 px-space-md text-right font-headline-sm font-mono">₹<%= Number(o.docTotal).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                  <td class="py-3 px-space-md text-center">
                    <span class="inline-block px-2 py-0.5 rounded text-label-sm font-semibold <%= statusBadge %>">
                      <%= o.status %>
                    </span>
                  </td>
                  <td class="py-3 px-space-md text-right">
                    <button onclick="viewOrderSlip('<%= o.orderNo %>')" class="p-1 hover:bg-surface-container rounded text-on-surface-variant hover:text-on-surface transition-colors" title="View Order">
                      <span class="material-symbols-outlined text-[18px]">visibility</span>
                    </button>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <!-- Pagination Footer -->
        <div class="flex items-center justify-between p-space-md bg-surface-container-lowest border-t border-surface-container text-body-sm text-on-surface-variant">
          <span>Showing <%= (salesOrders || []).length %> orders</span>
          <div class="flex items-center gap-1">
            <button class="px-2 py-1 bg-surface-container rounded" disabled>&laquo;</button>
            <button class="px-2.5 py-1 bg-secondary text-on-secondary rounded font-medium">1</button>
            <button class="px-2 py-1 bg-surface-container rounded" disabled>&raquo;</button>
          </div>
        </div>
      </div>

    </div>
  </main>
</div>

<!-- Modal: New Sales Order -->
<div id="newOrderModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
  <div class="bg-surface-container-lowest rounded-2xl shadow-2xl w-full max-w-lg overflow-hidden border border-outline-variant/30">
    <div class="p-space-md bg-surface-container-low border-b border-surface-container flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="material-symbols-outlined text-secondary">shopping_cart</span>
        <h3 class="font-headline-sm text-on-surface">Create Sales Order</h3>
      </div>
      <button onclick="closeModal('newOrderModal')" class="p-1 rounded-lg hover:bg-surface-container text-on-surface-variant">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>

    <form id="newOrderForm" onsubmit="handleNewOrderSubmit(event)" class="p-space-lg space-y-space-md">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-sm">
        <div>
          <label class="text-label-sm text-on-surface-variant block mb-1">Customer Name *</label>
          <input required name="customerName" placeholder="e.g. JEYAPANDI" class="w-full bg-surface-container text-on-surface px-3 py-2 rounded-lg text-body-md border border-outline-variant/30 outline-none focus:border-secondary"/>
        </div>
        <div>
          <label class="text-label-sm text-on-surface-variant block mb-1">Mobile *</label>
          <input required name="mobile" placeholder="e.g. 9500716518" class="w-full bg-surface-container text-on-surface px-3 py-2 rounded-lg text-body-md border border-outline-variant/30 outline-none focus:border-secondary"/>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-sm">
        <div>
          <label class="text-label-sm text-on-surface-variant block mb-1">Store</label>
          <select name="store" class="w-full bg-surface-container text-on-surface px-3 py-2 rounded-lg text-body-md border border-outline-variant/30 outline-none">
            <option value="ARC1">ARC1 - Retail</option>
            <option value="ARC2">ARC2 - Hub</option>
          </select>
        </div>
        <div>
          <label class="text-label-sm text-on-surface-variant block mb-1">Delivery Date</label>
          <input name="deliveryDate" type="date" class="w-full bg-surface-container text-on-surface px-3 py-2 rounded-lg text-body-md border border-outline-variant/30 outline-none"/>
        </div>
      </div>

      <div>
        <label class="text-label-sm text-on-surface-variant block mb-1">Item Description & Gross (₹) *</label>
        <div class="grid grid-cols-3 gap-2">
          <input required name="itemName" placeholder="e.g. Samsung Galaxy S24 Ultra" class="col-span-2 bg-surface-container text-on-surface px-3 py-2 rounded-lg text-body-md border border-outline-variant/30 outline-none focus:border-secondary"/>
          <input required type="number" step="0.01" id="orderGrossInput" name="grossTotal" placeholder="Price ₹" oninput="updateOrderDocTotal()" class="bg-surface-container text-on-surface px-3 py-2 rounded-lg text-body-md border border-outline-variant/30 outline-none focus:border-secondary font-mono"/>
        </div>
      </div>

      <div class="bg-surface-container-low p-3 rounded-xl flex items-center justify-between text-body-sm">
        <div>Tax (12% GST): <strong id="orderTaxPreview" class="font-mono text-on-surface">₹0.00</strong></div>
        <div>Doc Total: <strong id="orderTotalPreview" class="font-mono text-secondary text-base font-semibold">₹0.00</strong></div>
      </div>

      <div class="flex items-center justify-end gap-space-sm pt-space-xs border-t border-surface-container">
        <button type="button" onclick="closeModal('newOrderModal')" class="px-space-md py-2 rounded-lg bg-surface-container text-on-surface text-label-md">Cancel</button>
        <button type="submit" class="px-space-md py-2 rounded-lg bg-secondary text-on-secondary text-label-md hover:opacity-90 font-medium">Create Order</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal: View Sales Order Slip -->
<div id="orderSlipModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
  <div class="bg-surface-container-lowest rounded-2xl shadow-2xl w-full max-w-md overflow-hidden border border-outline-variant/30">
    <div class="p-space-md bg-surface-container-low border-b border-surface-container flex items-center justify-between">
      <h3 class="font-headline-sm text-on-surface">Sales Order Manifest</h3>
      <button onclick="closeModal('orderSlipModal')" class="p-1 rounded-lg hover:bg-surface-container text-on-surface-variant">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>
    <div id="orderSlipContent" class="p-space-lg space-y-3 text-body-sm"></div>
    <div class="p-space-md bg-surface-container-low border-t border-surface-container flex justify-end gap-2">
      <button onclick="window.print()" class="px-3 py-1.5 rounded-lg bg-surface-container text-on-surface text-xs font-semibold flex items-center gap-1">
        <span class="material-symbols-outlined text-[16px]">print</span> Print
      </button>
      <button onclick="closeModal('orderSlipModal')" class="px-3 py-1.5 rounded-lg bg-secondary text-on-secondary text-xs font-semibold">Done</button>
    </div>
  </div>
</div>

<%- include('partials/modals') %>

<script src="/js/common.js"></script>
<script>
  function openNewOrderModal() {
    openModal('newOrderModal');
  }

  function updateOrderDocTotal() {
    const gross = parseFloat(document.getElementById('orderGrossInput').value) || 0;
    const tax = Math.round(gross * 0.12 * 100) / 100;
    const total = gross + tax;
    document.getElementById('orderTaxPreview').textContent = `₹${tax.toLocaleString('en-IN', { minimumFractionDigits: 2 })}`;
    document.getElementById('orderTotalPreview').textContent = `₹${total.toLocaleString('en-IN', { minimumFractionDigits: 2 })}`;
  }

  async function handleNewOrderSubmit(e) {
    e.preventDefault();
    const form = e.target;
    const formData = new FormData(form);
    const payload = {
      customerName: formData.get('customerName'),
      mobile: formData.get('mobile'),
      store: formData.get('store'),
      deliveryDate: formData.get('deliveryDate'),
      itemName: formData.get('itemName'),
      grossTotal: formData.get('grossTotal')
    };

    try {
      const res = await fetch('/api/sales-orders', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (data.success) {
        showToast(`Sales Order ${data.data.orderNo} created!`, 'success');
        closeModal('newOrderModal');
        setTimeout(() => location.reload(), 400);
      } else {
        showToast(data.message || 'Error creating order', 'error');
      }
    } catch (err) {
      showToast('Network error: ' + err.message, 'error');
    }
  }

  function filterOrdersTable() {
    const query = document.getElementById('orderSearchInput').value.toLowerCase();
    const storeVal = document.getElementById('orderStoreFilter').value.toLowerCase();
    const statusVal = document.getElementById('orderStatusFilter').value.toLowerCase();

    const rows = document.querySelectorAll('#ordersTableBody tr');
    rows.forEach(row => {
      const text = row.innerText.toLowerCase();
      const storeCell = row.cells[4] ? row.cells[4].innerText.toLowerCase() : '';
      const statusCell = row.cells[8] ? row.cells[8].innerText.trim().toLowerCase() : '';

      const matchQuery = !query || text.includes(query);
      const matchStore = storeVal === 'all stores' || storeCell.includes(storeVal);
      const matchStatus = statusVal === 'all status' || statusCell.includes(statusVal);

      if (matchQuery && matchStore && matchStatus) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });
  }

  async function viewOrderSlip(orderNo) {
    try {
      const res = await fetch('/api/sales-orders');
      const orders = await res.json();
      const o = orders.find(x => x.orderNo === orderNo);
      if (!o) return;

      document.getElementById('orderSlipContent').innerHTML = `
        <div class="text-center pb-2 border-b border-surface-container">
          <h2 class="font-headline-md text-on-surface">Enterprise ERP - Order Confirmation</h2>
          <p class="text-xs text-on-surface-variant font-mono">${o.orderNo} • Store ${o.store}</p>
        </div>
        <div class="grid grid-cols-2 gap-2 text-xs py-2 border-b border-surface-container">
          <div><span class="text-on-surface-variant">Date:</span> ${o.date}</div>
          <div><span class="text-on-surface-variant">Customer:</span> <strong>${o.customerName}</strong></div>
          <div><span class="text-on-surface-variant">Mobile:</span> ${o.mobile}</div>
          <div><span class="text-on-surface-variant">Delivery:</span> ${o.deliveryDate}</div>
        </div>
        <div class="py-2 text-xs space-y-1">
          <div class="flex justify-between"><span>Gross Total:</span> <span class="font-mono">₹${Number(o.grossTotal).toLocaleString('en-IN')}</span></div>
          <div class="flex justify-between"><span>GST (12%):</span> <span class="font-mono">₹${Number(o.taxAmount).toLocaleString('en-IN')}</span></div>
          <div class="flex justify-between font-bold text-sm text-secondary pt-1 border-t"><span>Doc Total:</span> <span class="font-mono">₹${Number(o.docTotal).toLocaleString('en-IN')}</span></div>
        </div>
      `;
      openModal('orderSlipModal');
    } catch (err) {
      showToast('Failed to load order', 'error');
    }
  }

  function exportOrdersCSV() {
    showToast('Exporting Sales Orders CSV...', 'info');
    // Generate CSV on fly
    const rows = Array.from(document.querySelectorAll('#ordersTableBody tr'));
    let csv = 'ORDER NO,DATE,CUSTOMER,MOBILE,STORE,DELIVERY,GROSS,DOC TOTAL,STATUS\n';
    rows.forEach(r => {
      csv += `"${r.cells[0].innerText}","${r.cells[1].innerText}","${r.cells[2].innerText}","${r.cells[3].innerText}","${r.cells[4].innerText}","${r.cells[5].innerText}","${r.cells[6].innerText}","${r.cells[7].innerText}","${r.cells[8].innerText}"\n`;
    });
    const blob = new Blob([csv], { type: 'text/csv' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'sales_orders.csv';
    a.click();
  }
</script>
</body>
</html>
