<%- include('partials/head', { pageTitle: 'Enterprise ERP & POS Dashboard' }) %>

<%- include('partials/sidebar') %>

<div class="pl-64 min-h-screen flex flex-col">
  <%- include('partials/header') %>

  <main class="relative pt-28 bg-surface p-space-lg flex-1">
    <div class="flex flex-col w-full space-y-space-lg">

      <!-- Top Executive Banner -->
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-space-md bg-surface-container-low p-space-lg rounded-2xl shadow-sm border border-outline-variant/20">
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-secondary text-on-secondary uppercase tracking-wider">Enterprise POS v2.4</span>
            <span class="text-xs text-on-surface-variant font-medium">Store ARC1 • Active Counter</span>
          </div>
          <h1 class="font-headline-lg text-on-surface tracking-tight">Enterprise Operations & POS Dashboard</h1>
          <p class="font-body-md text-on-surface-variant">Unified management for Sales Orders, Customer Service, Store Inventory, and POS Checkout</p>
        </div>

        <!-- Hero Actions -->
        <div class="flex items-center gap-space-sm flex-wrap">
          <a href="/pos" class="flex items-center gap-2 bg-secondary text-on-secondary px-5 py-2.5 rounded-xl font-headline-sm text-sm hover:opacity-95 shadow-md active:scale-95 transition-all">
            <span class="material-symbols-outlined text-[20px]">point_of_sale</span>
            Open POS Register
          </a>
          <a href="/sales-orders" class="flex items-center gap-1.5 bg-surface-container-lowest text-on-surface px-4 py-2.5 rounded-xl text-label-md hover:bg-surface-container shadow-sm transition-all border border-outline-variant/30">
            <span class="material-symbols-outlined text-[18px]">shopping_cart</span>
            Sales Orders
          </a>
          <a href="/technician-assignment" class="flex items-center gap-1.5 bg-surface-container-lowest text-on-surface px-4 py-2.5 rounded-xl text-label-md hover:bg-surface-container shadow-sm transition-all border border-outline-variant/30">
            <span class="material-symbols-outlined text-[18px]">engineering</span>
            Technicians
          </a>
        </div>
      </div>

      <!-- 4 Core Pillars KPI Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-space-md">
        
        <!-- Pillar 1: SALES -->
        <a href="/sales-orders" class="bg-surface-container-lowest p-space-lg rounded-2xl shadow-sm border border-outline-variant/20 hover:border-secondary/50 hover:shadow-md transition-all flex flex-col justify-between group">
          <div class="flex items-start justify-between">
            <div>
              <span class="text-[11px] font-bold tracking-wider uppercase text-secondary">1. Sales Orders</span>
              <div class="font-headline-lg text-on-surface mt-1 font-mono">₹4,08,074</div>
              <p class="text-xs text-on-surface-variant mt-0.5">5 active store orders today</p>
            </div>
            <div class="w-11 h-11 rounded-xl bg-secondary-fixed text-on-secondary-fixed flex items-center justify-center">
              <span class="material-symbols-outlined text-[22px]">shopping_cart</span>
            </div>
          </div>
          <div class="mt-4 pt-2 border-t border-surface-container flex items-center justify-between text-xs text-secondary font-medium">
            <span>Manage Sales Orders</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </a>

        <!-- Pillar 2: POINT OF SALE -->
        <a href="/pos" class="bg-surface-container-lowest p-space-lg rounded-2xl shadow-sm border border-outline-variant/20 hover:border-secondary/50 hover:shadow-md transition-all flex flex-col justify-between group">
          <div class="flex items-start justify-between">
            <div>
              <span class="text-[11px] font-bold tracking-wider uppercase text-emerald-600">2. Point of Sale</span>
              <div class="font-headline-lg text-on-surface mt-1">Terminal 01</div>
              <p class="text-xs text-emerald-600 font-medium mt-0.5 flex items-center gap-1">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Ready for Billing
              </p>
            </div>
            <div class="w-11 h-11 rounded-xl bg-emerald-100 text-emerald-800 flex items-center justify-center">
              <span class="material-symbols-outlined text-[22px]">point_of_sale</span>
            </div>
          </div>
          <div class="mt-4 pt-2 border-t border-surface-container flex items-center justify-between text-xs text-emerald-700 font-medium">
            <span>Start POS Billing</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </a>

        <!-- Pillar 3: SERVICE -->
        <a href="/technician-assignment" class="bg-surface-container-lowest p-space-lg rounded-2xl shadow-sm border border-outline-variant/20 hover:border-secondary/50 hover:shadow-md transition-all flex flex-col justify-between group">
          <div class="flex items-start justify-between">
            <div>
              <span class="text-[11px] font-bold tracking-wider uppercase text-amber-600">3. Customer Service</span>
              <div class="font-headline-lg text-on-surface mt-1"><%= openCallsCount %> Open Calls</div>
              <p class="text-xs text-on-surface-variant mt-0.5"><%= techniciansCount %> Field Technicians active</p>
            </div>
            <div class="w-11 h-11 rounded-xl bg-amber-100 text-amber-800 flex items-center justify-center">
              <span class="material-symbols-outlined text-[22px]">engineering</span>
            </div>
          </div>
          <div class="mt-4 pt-2 border-t border-surface-container flex items-center justify-between text-xs text-amber-700 font-medium">
            <span>Drag & Assign Calls</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </a>

        <!-- Pillar 4: INVENTORY -->
        <a href="/stock-requests" class="bg-surface-container-lowest p-space-lg rounded-2xl shadow-sm border border-outline-variant/20 hover:border-secondary/50 hover:shadow-md transition-all flex flex-col justify-between group">
          <div class="flex items-start justify-between">
            <div>
              <span class="text-[11px] font-bold tracking-wider uppercase text-primary">4. Store Inventory</span>
              <div class="font-headline-lg text-on-surface mt-1"><%= stockRequestsCount %> Requests</div>
              <p class="text-xs text-on-surface-variant mt-0.5">5,732 items in stock catalog</p>
            </div>
            <div class="w-11 h-11 rounded-xl bg-primary-fixed text-on-primary-fixed flex items-center justify-center">
              <span class="material-symbols-outlined text-[22px]">inventory_2</span>
            </div>
          </div>
          <div class="mt-4 pt-2 border-t border-surface-container flex items-center justify-between text-xs text-primary font-medium">
            <span>Inter-Branch Transfers</span>
            <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </a>

      </div>

      <!-- Quick Operational Sections -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-space-lg">
        
        <!-- Left 2 Cols: Recent Sales Orders & Activity -->
        <div class="lg:col-span-2 space-y-space-lg">
          
          <!-- Recent Sales Orders -->
          <div class="bg-surface-container-lowest p-space-lg rounded-2xl shadow-sm border border-outline-variant/20">
            <div class="flex items-center justify-between mb-space-md">
              <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-secondary">shopping_cart</span>
                <h3 class="font-headline-md text-on-surface">Recent Sales Orders</h3>
              </div>
              <a href="/sales-orders" class="text-xs text-secondary font-semibold hover:underline">View All &rarr;</a>
            </div>

            <div class="overflow-x-auto">
              <table class="w-full text-left text-body-sm">
                <thead>
                  <tr class="text-on-surface-variant border-b border-surface-container text-label-sm font-semibold">
                    <th class="pb-2">Order No</th>
                    <th class="pb-2">Date</th>
                    <th class="pb-2">Customer</th>
                    <th class="pb-2 text-right">Doc Total</th>
                    <th class="pb-2 text-center">Status</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-surface-container">
                  <% (db.salesOrders || []).slice(0, 4).forEach(so => { 
                      let statusBadge = 'bg-secondary-fixed text-on-secondary-fixed';
                      if (so.status === 'Pending') statusBadge = 'bg-amber-100 text-amber-800';
                      if (so.status === 'Delivered') statusBadge = 'bg-emerald-100 text-emerald-800';
                  %>
                    <tr class="hover:bg-surface-container-low transition-colors">
                      <td class="py-2.5 font-medium text-secondary">
                        <a href="/sales-orders" class="hover:underline"><%= so.orderNo %></a>
                      </td>
                      <td class="py-2.5 text-on-surface-variant"><%= so.date %></td>
                      <td class="py-2.5 font-medium text-on-surface"><%= so.customerName %></td>
                      <td class="py-2.5 text-right font-mono font-semibold">₹<%= Number(so.docTotal).toLocaleString('en-IN', { minimumFractionDigits: 2 }) %></td>
                      <td class="py-2.5 text-center">
                        <span class="px-2 py-0.5 rounded text-label-sm font-semibold <%= statusBadge %>">
                          <%= so.status %>
                        </span>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Customer Equipment Cards (From Screenshot) -->
          <div class="bg-surface-container-lowest p-space-lg rounded-2xl shadow-sm border border-outline-variant/20">
            <div class="flex items-center justify-between mb-space-md">
              <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-secondary">badge</span>
                <h3 class="font-headline-md text-on-surface">Customer Equipment Cards</h3>
              </div>
              <a href="/customer-equipment-cards" class="text-xs text-secondary font-semibold hover:underline">Manage Cards &rarr;</a>
            </div>

            <div class="overflow-x-auto">
              <table class="w-full text-left text-body-sm">
                <thead>
                  <tr class="text-on-surface-variant border-b border-surface-container text-label-sm font-semibold">
                    <th class="pb-2">Customer</th>
                    <th class="pb-2">Item</th>
                    <th class="pb-2">Serial</th>
                    <th class="pb-2">Brand</th>
                    <th class="pb-2">Warranty To</th>
                    <th class="pb-2 text-center">Status</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-surface-container">
                  <% (db.customerEquipmentCards || []).slice(0, 3).forEach(ec => { %>
                    <tr class="hover:bg-surface-container-low transition-colors">
                      <td class="py-2.5 font-medium"><%= ec.customer %></td>
                      <td class="py-2.5 text-on-surface-variant"><%= ec.item %></td>
                      <td class="py-2.5 text-secondary font-mono"><%= ec.serial %></td>
                      <td class="py-2.5 text-on-surface-variant"><%= ec.brand %></td>
                      <td class="py-2.5 text-on-surface-variant"><%= ec.warrantyTo %></td>
                      <td class="py-2.5 text-center">
                        <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800">
                          Active
                        </span>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>

        </div>

        <!-- Right Col: Service & Finance Snapshots -->
        <div class="space-y-space-lg">
          
          <!-- Field Technicians Roster -->
          <div class="bg-surface-container-lowest p-space-lg rounded-2xl shadow-sm border border-outline-variant/20">
            <div class="flex items-center justify-between mb-space-md">
              <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-secondary">engineering</span>
                <h3 class="font-headline-md text-on-surface">Field Technicians</h3>
              </div>
              <a href="/technician-assignment" class="text-xs text-secondary font-semibold hover:underline">Board &rarr;</a>
            </div>

            <div class="space-y-2.5">
              <% (db.technicians || []).forEach(tech => { 
                  const isAvailable = tech.status === 'Available';
              %>
                <div class="flex items-center justify-between p-2.5 rounded-xl bg-surface-container-low">
                  <div class="flex items-center gap-2.5">
                    <span class="w-8 h-8 rounded-full bg-primary-fixed text-on-primary-fixed flex items-center justify-center font-bold text-xs">
                      <%= tech.initial %>
                    </span>
                    <div>
                      <p class="text-xs font-semibold text-on-surface"><%= tech.name %></p>
                      <p class="text-[11px] text-on-surface-variant"><%= tech.specialty %></p>
                    </div>
                  </div>
                  <div class="text-right">
                    <span class="px-2 py-0.5 rounded text-[10px] font-semibold <%= isAvailable ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800' %>">
                      <%= tech.status %>
                    </span>
                    <span class="block text-[10px] text-on-surface-variant mt-0.5"><%= tech.assignedToday %> assigned</span>
                  </div>
                </div>
              <% }); %>
            </div>
          </div>

          <!-- Finance Receipts Snapshot -->
          <div class="bg-surface-container-lowest p-space-lg rounded-2xl shadow-sm border border-outline-variant/20">
            <div class="flex items-center justify-between mb-space-md">
              <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-secondary">account_balance</span>
                <h3 class="font-headline-md text-on-surface">Finance Receipts</h3>
              </div>
              <a href="/finance-receipts" class="text-xs text-secondary font-semibold hover:underline">View All &rarr;</a>
            </div>

            <div class="space-y-2">
              <% (db.financeReceipts || []).slice(0, 2).forEach(fr => { %>
                <div class="p-2.5 rounded-xl bg-surface-container-low flex items-center justify-between text-xs">
                  <div>
                    <span class="font-medium text-secondary font-mono"><%= fr.receiptNo %></span>
                    <span class="block font-semibold text-on-surface"><%= fr.customer %></span>
                    <span class="text-on-surface-variant text-[11px]"><%= fr.financier %> • <%= fr.doNumber %></span>
                  </div>
                  <div class="text-right">
                    <span class="font-mono font-bold text-on-surface">₹<%= Number(fr.total).toLocaleString('en-IN') %></span>
                    <span class="block px-2 py-0.5 rounded text-[10px] font-semibold mt-1 <%= fr.status === 'CONFIRMED' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800' %>">
                      <%= fr.status %>
                    </span>
                  </div>
                </div>
              <% }); %>
            </div>
          </div>

        </div>

      </div>

    </div>
  </main>
</div>

<%- include('partials/modals') %>

<script src="/js/common.js"></script>
</body>
</html>
